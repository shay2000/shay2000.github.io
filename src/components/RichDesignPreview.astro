---
import { richContent, snapshotDate } from '../lib/rich-alternatives';
interface Props { kind: string; }
const { kind } = Astro.props;
const { projects, articles } = await richContent();
---
<div class={`rich-preview preview-${kind}`} aria-hidden="true">
  {kind === 'mission-desk' ? <>
    <div class="preview-header"><span>SHAY / 09 / ENGINEERING FILE</span><b>Mission <em>Desk.</em></b><small>Small tools that fix specific annoyances.</small></div>
    <div class="mini-tabs">01 / SELECTED BUILDS　 02 / REPOSITORY RECORD</div>
    <div class="mini-operations"><div>{projects.slice(0,3).map((p,i) => <div class="mini-payload"><span>0{i+1} / {p.stack[0]}</span><b>{p.title}</b><p>{p.tagline}</p></div>)}</div><aside><span>OPERATIONS LOG</span><b>Snapshot,<br/>not live.</b><p>{snapshotDate}</p><hr/><p>Repository history</p><p>Language inventory</p><p>Engineering notes</p></aside></div>
  </> : kind === 'the-independent' ? <>
    <div class="preview-header"><span>SHAY / AN INDEPENDENT SOFTWARE JOURNAL</span><b>The Independent.</b></div><div class="mini-tabs">THE BUILDS / DISPATCHES / THE RECORD</div>
    <div class="mini-front"><div><b>Built because<br/>the thing <em>didn't quite exist yet.</em></b><p>macOS utilities, self-hosted services, and research tooling.</p><div class="mini-story"><span>IN FOCUS</span><b>{projects[0].title}</b><p>{projects[0].tagline}</p></div></div><aside><span>FROM THE WRITING DESK</span>{articles.slice(0,2).map(a => <div class="mini-story"><b>{a.data.title}</b><p>{a.data.description}</p></div>)}</aside></div>
  </> : <>
    <div class="preview-header"><span>SHAY / 11 / INDEPENDENT SOFTWARE</span><b>PARTS<br/>CATALOGUE /</b></div><div class="mini-tabs">COMPONENTS / BENCH RECORD / MANUALS</div>
    <div class="mini-cabinet">{projects.slice(0,4).map((p,i) => <div class="mini-drawer"><span>P—0{i+1}</span><div><b>{p.title}</b><p>{i === 0 ? p.tagline : p.stack.join(' / ')}</p></div><i>{i === 0 ? '−' : '+'}</i></div>)}</div><div class="mini-slip">PUBLIC SOURCE / OPEN THE DRAWERS</div>
  </>}
</div>
<style>
.rich-preview{height:100%;min-height:470px;padding:24px;overflow:hidden;font-family:'Inter Variable',sans-serif}.rich-preview span,.mini-tabs,.mini-slip{font:8px/1.7 'JetBrains Mono Variable',monospace}.preview-header>b{display:block;font-size:42px;line-height:1.05;letter-spacing:-.06em;margin:14px 0}.preview-header small{font-size:11px}.mini-tabs{border-block:1px solid;padding:9px 0;margin:15px 0}.rich-preview p{font-size:10px;line-height:1.7;margin:8px 0}.rich-preview b{font-weight:650}.preview-mission-desk{background:#f1edde;color:#182b3b;border-top:7px solid #b33520}.preview-mission-desk em{color:#b33520;font-style:normal}.mini-operations{display:grid;grid-template-columns:1.7fr 1fr;gap:16px}.mini-payload{padding:12px 0;border-bottom:1px solid #182b3b66}.mini-payload:first-child{padding:14px;background:#182b3b;color:#f1edde;border-top:4px solid #b33520}.mini-payload b{display:block;font-size:23px;margin:5px 0;letter-spacing:-.04em}.mini-operations aside{background:#e6e0cf;padding:12px}.mini-operations aside>b{display:block;font-size:18px;line-height:1.15;margin-top:15px}.preview-the-independent{background:#f7f4ea;color:#25291f;border-top:3px solid}.preview-the-independent .preview-header>b{font-family:'Fraunces Variable',Georgia,serif;font-size:42px;letter-spacing:-.07em}.mini-front{display:grid;grid-template-columns:1.65fr 1fr;gap:18px}.mini-front>div>b{font:34px/1.08 'Fraunces Variable',Georgia,serif;letter-spacing:-.05em;display:block}.mini-front em{color:#7a3423}.mini-front aside{border-left:1px solid #25291f55;padding-left:14px}.mini-story{border-top:1px solid;padding-top:12px;margin-top:18px}.mini-story b{font:20px/1.15 'Fraunces Variable',Georgia,serif;display:block}.mini-front aside .mini-story b{font-size:17px}.preview-parts-catalogue{background:#e4e1d6;color:#293127}.preview-parts-catalogue .preview-header>b{font-weight:800}.mini-cabinet{padding:5px;background:#a8aa9d;border:1px solid;box-shadow:4px 4px 0 #29312733}.mini-drawer{display:grid;grid-template-columns:37px 1fr 23px;gap:12px;align-items:center;padding:12px;background:#efede3;border:1px solid #29312777;margin-bottom:5px}.mini-drawer:last-child{margin-bottom:0}.mini-drawer b{font-size:19px;line-height:1.1;display:block;letter-spacing:-.04em}.mini-drawer p{margin:5px 0 0;font-size:9px}.mini-drawer i{font-style:normal;text-align:center;border:1px solid;border-bottom-width:3px}.mini-slip{margin-top:17px;border-block:1px dashed;padding:8px 0}@media(max-width:400px){.rich-preview{padding:16px;min-height:460px}.preview-header>b,.preview-the-independent .preview-header>b{font-size:33px}.mini-front>div>b{font-size:27px}.mini-front{gap:12px;grid-template-columns:1.4fr 1fr}.mini-front aside{padding-left:10px}.mini-story b{font-size:18px}.mini-front aside .mini-story b{font-size:15px}.mini-drawer{gap:8px;padding:12px 8px}.mini-drawer b{font-size:17px}.mini-payload b{font-size:19px}.mini-operations{gap:10px}.mini-operations aside{padding:9px}.mini-operations aside>b{font-size:16px}}
</style>
