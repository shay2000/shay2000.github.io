---
import ThemeToggle from './ThemeToggle.astro';
import AlternativeDesigns from './AlternativeDesigns.astro';
import { NAV, SITE } from '../lib/site';

const path = Astro.url.pathname;

function isActive(href: string) {
  if (href === '/') return path === '/' || path === '';
  return path.startsWith(href);
}
---

<header class="hdr" id="site-header">
  <div class="shell hdr__inner">
    <a href="/" class="brand" aria-label={`${SITE.title} — home`}>
      <span class="brand__tilde">~</span><span class="brand__slash">/</span><span class="brand__name">shay2000</span><span class="brand__cursor" aria-hidden="true"></span>
    </a>

    <nav class="nav" id="site-nav" aria-label="Primary">
      {NAV.map((item) => (
        <a
          href={item.href}
          class:list={['nav__link', { 'is-active': isActive(item.href) }]}
          aria-current={isActive(item.href) ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
      <AlternativeDesigns />
    </nav>

    <div class="hdr__actions">
      <button class="kbd-btn" id="cmdk-open" type="button" aria-label="Search the site">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
          <circle cx="11" cy="11" r="6.5" />
          <path d="m16 16 4.5 4.5" />
        </svg>
        <span class="kbd-btn__text">Search</span>
        <kbd>⌘K</kbd>
      </button>

      <a
        class="icon-btn"
        href={SITE.github}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub profile"
        title="GitHub"
      >
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 2C6.48 2 2 6.58 2 12.25c0 4.53 2.87 8.37 6.84 9.73.5.1.68-.22.68-.49 0-.24-.01-1.05-.01-1.9-2.78.62-3.37-1.2-3.37-1.2-.45-1.18-1.11-1.5-1.11-1.5-.91-.63.07-.62.07-.62 1 .07 1.53 1.05 1.53 1.05.9 1.56 2.34 1.11 2.91.85.09-.66.35-1.11.63-1.37-2.22-.26-4.56-1.14-4.56-5.05 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.7 0 0 .84-.28 2.75 1.05a9.3 9.3 0 0 1 5.01 0c1.91-1.33 2.75-1.05 2.75-1.05.55 1.4.2 2.44.1 2.7.64.72 1.03 1.63 1.03 2.75 0 3.92-2.34 4.79-4.57 5.04.36.32.68.94.68 1.9 0 1.37-.01 2.48-.01 2.82 0 .27.18.6.69.49A10.03 10.03 0 0 0 22 12.25C22 6.58 17.52 2 12 2Z" />
        </svg>
      </a>

      <ThemeToggle />

      <button
        class="burger"
        id="nav-toggle"
        type="button"
        aria-label="Menu"
        aria-expanded="false"
        aria-controls="site-nav"
      >
        <span></span><span></span>
      </button>
    </div>
  </div>
</header>

<style>
  .hdr {
    position: sticky;
    top: 0;
    z-index: 200;
    border-bottom: 1px solid transparent;
    transition: border-color var(--dur) var(--ease-out),
      background-color var(--dur) var(--ease-out),
      backdrop-filter var(--dur) var(--ease-out);
  }

  .hdr.is-stuck {
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: saturate(180%) blur(14px);
    -webkit-backdrop-filter: saturate(180%) blur(14px);
    border-bottom-color: var(--line);
  }

  .hdr__inner {
    display: flex;
    align-items: center;
    gap: var(--sp-4);
    height: var(--header-h);
  }

  /* --- wordmark --- */
  .brand {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--ink);
    margin-right: auto;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .brand__tilde {
    color: var(--accent);
  }

  .brand__slash {
    color: var(--ink-faint);
  }

  .brand__name {
    letter-spacing: -0.03em;
  }

  .brand__cursor {
    display: inline-block;
    width: 7px;
    height: 1.05em;
    margin-left: 3px;
    background: var(--accent);
    animation: blink 1.15s steps(2, start) infinite;
  }

  @keyframes blink {
    0%, 45% { opacity: 1; }
    50%, 100% { opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .brand__cursor { animation: none; }
  }

  /* --- nav --- */
  .nav {
    display: flex;
    align-items: center;
    gap: 2px;
  }

  .nav__link {
    position: relative;
    padding: 0.42em 0.78em;
    border-radius: var(--r-full);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--ink-mute);
    transition: color var(--dur-fast) var(--ease-out),
      background-color var(--dur-fast) var(--ease-out);
  }

  .nav__link:hover {
    color: var(--ink);
    background: var(--bg-sunken);
  }

  .nav__link.is-active {
    color: var(--accent);
    background: var(--accent-soft);
  }

  /* --- actions --- */
  .hdr__actions {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    margin-left: auto;
  }

  .kbd-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    height: 34px;
    padding: 0 0.5em 0 0.7em;
    border: 1px solid var(--line-mid);
    border-radius: var(--r-full);
    background: transparent;
    color: var(--ink-mute);
    cursor: pointer;
    transition: color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);
  }

  .kbd-btn:hover {
    color: var(--ink);
    border-color: var(--line-strong);
  }

  .kbd-btn svg {
    width: 14px;
    height: 14px;
  }

  .kbd-btn__text {
    font-family: var(--font-mono);
    font-size: var(--step--2);
  }

  .kbd-btn kbd {
    font-family: var(--font-mono);
    font-size: 10px;
    padding: 2px 5px;
    border: 1px solid var(--line);
    border-radius: 4px;
    background: var(--bg-sunken);
    color: var(--ink-faint);
  }

  .icon-btn {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border: 1px solid var(--line-mid);
    border-radius: var(--r-full);
    color: var(--ink-soft);
    transition: color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out),
      transform var(--dur) var(--ease-spring);
  }

  .icon-btn svg {
    width: 16px;
    height: 16px;
  }

  .icon-btn:hover {
    color: var(--accent);
    border-color: var(--accent-line);
    transform: translateY(-2px);
  }

  /* --- mobile --- */
  .burger {
    display: none;
    width: 34px;
    height: 34px;
    padding: 0;
    border: 1px solid var(--line-mid);
    border-radius: var(--r-full);
    background: transparent;
    cursor: pointer;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
  }

  .burger span {
    display: block;
    width: 14px;
    height: 1.5px;
    background: var(--ink);
    transition: transform var(--dur) var(--ease-out),
      opacity var(--dur) var(--ease-out);
  }

  .burger[aria-expanded='true'] span:first-child {
    transform: translateY(2.75px) rotate(45deg);
  }

  .burger[aria-expanded='true'] span:last-child {
    transform: translateY(-2.75px) rotate(-45deg);
  }

  @media (max-width: 1100px) {
    .burger {
      display: flex;
    }

    .kbd-btn__text,
    .kbd-btn kbd {
      display: none;
    }

    .kbd-btn {
      width: 34px;
      justify-content: center;
      padding: 0;
    }

    .nav {
      position: absolute;
      top: var(--header-h);
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: var(--sp-3) var(--gutter) var(--sp-5);
      background: var(--bg-elev);
      border-bottom: 1px solid var(--line);
      box-shadow: var(--shadow);
      transform-origin: top;
      opacity: 0;
      visibility: hidden;
      transform: translateY(-8px) scaleY(0.97);
      pointer-events: none;
      transition: opacity var(--dur) var(--ease-out),
        transform var(--dur) var(--ease-out);
    }

    .nav.is-open {
      visibility: visible;
      opacity: 1;
      transform: none;
      pointer-events: auto;
    }

    .nav__link {
      padding: 0.85em 0.6em;
      border-radius: var(--r-md);
      font-size: var(--step-0);
      border-bottom: 1px solid var(--line);
    }

    .nav__link:last-child {
      border-bottom: 0;
    }
  }
</style>

<script>
  // Header condenses once the page scrolls.
  const header = document.getElementById('site-header');
  const onScroll = () => header?.classList.toggle('is-stuck', window.scrollY > 12);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  // Mobile nav
  const toggle = document.getElementById('nav-toggle');
  const nav = document.getElementById('site-nav');
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    nav?.classList.toggle('is-open', !open);
  });

  nav?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) {
      toggle?.setAttribute('aria-expanded', 'false');
      nav.classList.remove('is-open');
    }
  });
</script>
