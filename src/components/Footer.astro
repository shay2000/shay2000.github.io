---
import { SITE, NAV } from '../lib/site';
import { profile } from '../lib/data';

const year = new Date().getFullYear();

const elsewhere = [
  { label: 'GitHub', href: SITE.github },
  { label: 'RSS', href: '/rss.xml' },
  { label: 'Sitemap', href: '/sitemap-index.xml' },
];
---

<footer class="ftr">
  <div class="shell">
    <div class="ftr__top">
      <div class="ftr__brand">
        <p class="ftr__mark">
          <span class="ftr__tilde">~</span>/shay2000
        </p>
        <p class="ftr__tag">{SITE.tagline}</p>

        <a
          class="ftr__coffee"
          href={SITE.coffee}
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="ftr__coffee-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
              <path d="M17 8h1.4a2.6 2.6 0 0 1 0 5.2H17" />
              <path d="M4 8h13v6.2A5.3 5.3 0 0 1 11.7 19.5H9.3A5.3 5.3 0 0 1 4 14.2V8Z" />
              <path d="M8 2.6c-.5 1 .5 1.4 0 2.4M12 2.6c-.5 1 .5 1.4 0 2.4" />
            </svg>
          </span>
          Buy me a coffee
          <span class="ftr__coffee-go" aria-hidden="true">↗</span>
        </a>
      </div>

      <nav class="ftr__nav" aria-label="Footer">
        <div class="ftr__col">
          <p class="label">Sections</p>
          {NAV.map((n) => (
            <a href={n.href} class="ftr__link">{n.label}</a>
          ))}
        </div>

        <div class="ftr__col">
          <p class="label">Elsewhere</p>
          {elsewhere.map((n) => (
            <a
              href={n.href}
              class="ftr__link"
              target={n.href.startsWith('http') ? '_blank' : undefined}
              rel={n.href.startsWith('http') ? 'noopener noreferrer' : undefined}
            >
              {n.label}
            </a>
          ))}
        </div>

        <div class="ftr__col">
          <p class="label">This site</p>
          <span class="ftr__meta">Astro · no trackers</span>
          <span class="ftr__meta">Static build</span>
          <span class="ftr__meta">
            Data from GitHub
          </span>
        </div>
      </nav>
    </div>

    <div class="ftr__base">
      <span class="ftr__meta">© {year} {profile.name}</span>
      <span class="ftr__meta ftr__meta--dim">
        Build data refreshed {profile.generatedAt.slice(0, 10)}
      </span>
      <button class="ftr__top-btn" id="to-top" type="button">
        Back to top <span aria-hidden="true">↑</span>
      </button>
    </div>
  </div>
</footer>

<style>
  .ftr {
    border-top: 1px solid var(--line);
    background: var(--bg-sunken);
    padding-block: var(--sp-7) var(--sp-5);
    margin-top: var(--sp-8);
  }

  .ftr__top {
    display: grid;
    grid-template-columns: minmax(220px, 1fr) 2fr;
    gap: var(--sp-7);
    padding-bottom: var(--sp-6);
    border-bottom: 1px solid var(--line);
  }

  .ftr__mark {
    font-family: var(--font-mono);
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  .ftr__tilde {
    color: var(--accent);
  }

  .ftr__tag {
    margin-top: 0.5rem;
    font-family: var(--font-serif);
    font-size: var(--step-1);
    color: var(--ink-soft);
    max-width: 26ch;
    line-height: 1.3;
  }

  .ftr__coffee {
    display: inline-flex;
    align-items: center;
    gap: 0.55em;
    margin-top: 1.15rem;
    padding: 0.5em 0.95em 0.5em 0.6em;
    border: 1px solid var(--line-mid);
    border-radius: var(--r-full);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--ink-soft);
    background: var(--bg-elev);
    transition: border-color var(--dur) var(--ease-out),
      color var(--dur-fast) var(--ease-out),
      transform var(--dur) var(--ease-out);
  }

  .ftr__coffee:hover {
    border-color: var(--accent);
    color: var(--accent);
    transform: translateY(-2px);
  }

  .ftr__coffee-icon {
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border-radius: var(--r-full);
    background: var(--accent-soft);
    color: var(--accent);
  }

  .ftr__coffee-icon svg {
    width: 13px;
    height: 13px;
  }

  .ftr__coffee-go {
    color: var(--ink-faint);
    transition: transform var(--dur) var(--ease-spring);
  }

  .ftr__coffee:hover .ftr__coffee-go {
    transform: translate(2px, -2px);
  }

  .ftr__nav {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--sp-5);
  }

  .ftr__col {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .ftr__col .label {
    margin-bottom: 0.35rem;
  }

  .ftr__link {
    font-size: var(--step--1);
    color: var(--ink-soft);
    width: fit-content;
    transition: color var(--dur-fast) var(--ease-out),
      transform var(--dur-fast) var(--ease-out);
  }

  .ftr__link:hover {
    color: var(--accent);
    transform: translateX(3px);
  }

  .ftr__meta {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--ink-mute);
  }

  .ftr__meta--dim {
    color: var(--ink-faint);
  }

  .ftr__base {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-4);
    flex-wrap: wrap;
    padding-top: var(--sp-4);
  }

  .ftr__top-btn {
    background: none;
    border: 0;
    padding: 0;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--ink-mute);
    cursor: pointer;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .ftr__top-btn:hover {
    color: var(--accent);
  }

  @media (max-width: 860px) {
    .ftr__top {
      grid-template-columns: 1fr;
      gap: var(--sp-6);
    }

    .ftr__nav {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--sp-5) var(--sp-4);
    }
  }
</style>

<script>
  document.getElementById('to-top')?.addEventListener('click', () => {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
  });
</script>
