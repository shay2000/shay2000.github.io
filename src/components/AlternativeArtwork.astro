---
interface Props { kind?: string; }
const { kind = 'atlas' } = Astro.props;
---
<svg viewBox="0 0 600 500" fill="none" aria-hidden="true" class={`art art-${kind}`}>
{kind === 'atlas' && <>
  <circle cx="300" cy="250" r="183" fill="currentColor" />
  {Array.from({length: 23}, (_, i) => <path d={`M80 ${84+i*15}H520`} stroke="var(--paper)" stroke-width={i%3===0?4:1.5} />)}
  <path d="M300 25V475M65 250H535" stroke="var(--accent)" stroke-width="2" />
  <circle cx="300" cy="250" r="215" stroke="currentColor" stroke-width=".6" />
  <circle cx="300" cy="250" r="10" fill="var(--accent)" />
  <path d="M80 45h40m-20-20v40M480 455h40m-20-20v40" stroke="currentColor" />
</>}
{kind === 'studio' && <g class="studio-mark" fill="currentColor">
  {Array.from({length: 12}, (_, i) => <rect x="260" y="35" width="80" height="220" rx="40" transform={`rotate(${i*30} 300 250)`} />)}
  <circle cx="300" cy="250" r="70" fill="var(--paper)" />
  <circle cx="300" cy="250" r="23" fill="currentColor" />
</g>}
{kind === 'fieldnotes' && <>
  <path d="M95 335 300 425 505 335 300 245Z" stroke="currentColor" stroke-width="2" />
  <path d="M95 260 300 350 505 260 300 170Z" fill="var(--paper)" stroke="currentColor" stroke-width="2" />
  <path d="M95 185 300 275 505 185 300 95Z" fill="var(--paper)" stroke="currentColor" stroke-width="2" />
  <path d="m170 185 130 57 130-57-130-57Z" stroke="var(--accent)" stroke-width="2" />
  <path d="M300 55V445M55 185H550" stroke="currentColor" stroke-dasharray="3 8" />
  <circle cx="300" cy="185" r="22" fill="var(--accent)" />
  <path d="m470 95 45-30m-12 1 12-1-3 12M85 365l-35 30m0-12v12h12" stroke="var(--accent)" stroke-width="2" />
</>}
</svg>
<style>
  .art { width:100%; height:100%; }
  .studio-mark { transform-origin:300px 250px; transition:transform .8s cubic-bezier(.2,.8,.2,1); }
  .art-studio:hover .studio-mark { transform:rotate(30deg); }
  @media(prefers-reduced-motion:reduce) { .studio-mark { transition:none; } .art-studio:hover .studio-mark { transform:none; } }
</style>
