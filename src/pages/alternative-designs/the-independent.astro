---
import Layout from '../../layouts/AlternativeLayout.astro';
import Ledger from '../../components/SnapshotLedger.astro';
import Activity from '../../components/SnapshotActivity.astro';
import { richContent, snapshotDate, stamp } from '../../lib/rich-alternatives';
import { profile } from '../../lib/data';
import { SITE } from '../../lib/site';
import '../../styles/rich-alternatives.css';
const { projects, articles } = await richContent();
---
<Layout title="The Independent" theme="the-independent" description="An independent journal of small software, practical decisions and public work.">
  <div class="rich-shell newspaper">
    <div class="issue-line kicker"><span>A journal of useful software / Shay</span><span>Repository edition · {snapshotDate}</span></div>
    <h1 class="masthead">The Independent<span>.</span></h1>
    <nav class="paper-nav" aria-label="Sections"><a href="#builds">The builds</a><a href="#dispatches">Dispatches</a><a href="#record">The record</a><a href="/about">About the author ↗</a></nav>
    <div class="front-page">
      <section class="lead-story" aria-labelledby="lead-title"><p class="kicker">The brief / small tools, specific annoyances</p><h2 id="lead-title">Built because the thing <em>didn't quite exist yet.</em></h2><p class="standfirst">macOS menu-bar utilities, self-hosted services, and research tooling. Everything here is public, deliberately small, and built to solve a real problem.</p><div class="byline"><span class="author-seal" aria-hidden="true">S.</span><div><strong>Shay / @{profile.login}</strong><p>Builder · occasional writer<br/>Open source since {new Date(profile.joinedAt).getUTCFullYear()}</p></div></div><div class="rich-links"><a class="rich-link" href={profile.url}>GitHub profile ↗</a><a class="rich-link" href={SITE.coffee}>Support the work ↗</a></div>
        <article class="cover-project"><p class="kicker">In focus / {projects[0].stack.join(' · ')}</p><h3><a href={projects[0].href}>{projects[0].title}</a></h3><p class="standfirst">{projects[0].tagline}</p><p>{projects[0].excerpt}</p><a class="rich-link" href={projects[0].href}>Inside the build →</a></article>
      </section>
      <aside class="front-column"><span class="column-label kicker">From the writing desk</span>{articles.slice(0,2).map(a => <article><p class="reading-date">{stamp(a.data.date)}</p><a class="note-title" href={`/writing/${a.id}`}>{a.data.title}</a><p class="note-excerpt">{a.excerpt}</p><a class="rich-link" href={`/writing/${a.id}`}>Continue reading →</a></article>)}<p class="editor-note">A note on the numbers: this edition uses saved repository data, not live telemetry. Fork history is included.</p></aside>
    </div>
    <section id="builds"><div class="section-rule"><h2>The useful things.</h2><a class="rich-link" href="/projects">All {profile.stats.trackedRepos} tracked builds →</a></div><div class="build-columns">{projects.map((p,i) => <article class="paper-build scroll-entry"><span class="kicker">{String(i+1).padStart(2,'0')} / {p.isFork ? 'Fork / maintained' : 'Original work'}</span><h3><a href={p.href}>{p.title}</a></h3><p class="build-deck">{p.tagline}</p><p>{p.excerpt}</p><p class="stack">{p.stack.join(' / ')}</p><div class="rich-links"><a class="rich-link" href={p.href}>Read the brief →</a><a class="rich-link" href={p.url}>Source ↗</a></div></article>)}</div></section>
    <section id="record" class="paper-record"><div class="record-main"><Ledger /><div class="record-foot"><span class="kicker">Archive, not scoreboard</span><p>{profile.stats.totalCommitsSampled} commits in the full saved sample; {profile.stats.originalRepos} original and {profile.stats.forkedRepos} forked repositories. The chart above covers its labelled period only.</p></div><Ledger section="languages" /></div><aside><Activity /></aside></section>
    <section id="dispatches"><div class="section-rule"><h2>Dispatches & field notes.</h2><a class="rich-link" href="/writing">Writing archive →</a></div><div class="dispatches">{articles.map((a,i) => <article class="dispatch scroll-entry"><span class="dispatch-number" aria-hidden="true">{String(i+1).padStart(2,'0')}</span><div><p class="reading-date">{stamp(a.data.date)}</p><a class="note-title" href={`/writing/${a.id}`}>{a.data.title}</a><p class="note-excerpt">{a.excerpt}</p><a class="rich-link" href={`/writing/${a.id}`}>Read the full essay →</a></div></article>)}</div></section>
    <div class="colophon"><p>Independently built.<br/><em>Openly shared.</em></p><div class="rich-links"><a class="rich-link" href="/rss.xml">Subscribe via RSS ↗</a><a class="rich-link" href={SITE.coffee}>Buy me a coffee ↗</a></div></div>
  </div>
</Layout>
<style>
:global(body.the-independent){--paper:#f7f4ea;--ink:#25291f;--accent:#7a3423}.newspaper{max-width:1450px}.issue-line{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;border-top:3px solid;padding-top:10px}.masthead{font-family:'Fraunces Variable',Georgia,serif;font-size:clamp(39px,8.7vw,128px);font-weight:550;letter-spacing:-.075em;padding:12px 0 22px;line-height:1.05}.masthead span{color:var(--accent)}.paper-nav{display:flex;gap:12px 32px;flex-wrap:wrap;border-block:1px solid}.paper-nav a{display:flex;align-items:center;min-height:46px;font-size:12px;text-decoration:none}.front-page{display:grid;grid-template-columns:1.8fr 1fr;gap:48px;padding:32px 0}.lead-story h2{font-family:'Fraunces Variable',Georgia,serif;font-size:clamp(36px,4.7vw,66px);max-width:17ch;margin:16px 0 22px;line-height:1.07}.lead-story h2 em{font-weight:400;color:var(--accent)}.standfirst{font-family:Georgia,serif;font-size:20px;line-height:1.6;max-width:55ch}.byline{display:flex;align-items:center;gap:16px;margin-top:24px;font-size:12px}.byline p{font-size:11px}.author-seal{display:grid;place-items:center;width:54px;height:54px;border:1px solid;border-radius:50%;font:italic 30px Georgia,serif}.cover-project{margin-top:28px;border-top:5px solid;padding-top:20px}.cover-project h3{font-family:'Fraunces Variable',Georgia,serif;font-size:42px;margin:12px 0}.cover-project h3 a{display:inline-flex;min-height:44px;align-items:center;text-decoration:none}.cover-project>p:not(.kicker){margin-bottom:15px}.cover-project>p:not(.kicker,.standfirst){font-size:14px;line-height:1.8}.front-column{border-left:1px solid #25291f55;padding-left:32px}.column-label{display:block;border-bottom:1px solid;padding-bottom:12px}.front-column article{padding:20px 0;border-bottom:1px solid #25291f55}.front-column .note-title{font-family:'Fraunces Variable',Georgia,serif;font-size:30px}.editor-note{font:italic 16px/1.65 Georgia,serif;margin-top:24px}.build-columns{display:grid;grid-template-columns:1.4fr 1fr;gap:0 44px}.paper-build{padding:25px 0;border-bottom:1px solid #25291f55}.paper-build h3{font:36px/1.1 'Fraunces Variable',Georgia,serif;margin:12px 0}.paper-build h3 a{display:inline-flex;align-items:center;min-height:44px;text-decoration:none}.paper-build p{font-size:14px;line-height:1.85;margin-bottom:12px}.paper-build .build-deck{font-weight:650}.paper-build .stack{font-size:10px}.paper-record{display:grid;grid-template-columns:1.5fr 1fr;gap:60px;border-block:3px double;padding-block:32px;margin-top:40px}.record-foot{margin:24px 0 32px;padding:15px 0;border-block:1px solid #25291f55;font-size:13px}.record-foot p{margin-top:8px}.paper-record aside{border-left:1px solid #25291f55;padding-left:30px}.dispatches{display:grid;grid-template-columns:1fr 1fr;gap:0 40px}.dispatch{display:grid;grid-template-columns:40px 1fr;gap:16px;padding:25px 0;border-bottom:1px solid #25291f55}.dispatch-number{font:italic 27px Georgia,serif;color:var(--accent)}.dispatch .note-title{font-family:'Fraunces Variable',Georgia,serif;font-size:28px}.colophon{display:flex;justify-content:space-between;gap:30px;align-items:center;border-top:3px solid;padding-top:25px;margin-top:40px}.colophon>p{font:32px/1.2 'Fraunces Variable',Georgia,serif}a:hover{text-decoration:underline}
@media(max-width:760px){.front-page,.paper-record{grid-template-columns:1fr;gap:30px}.front-column,.paper-record aside{padding-left:0;border-left:0}.build-columns,.dispatches{grid-template-columns:1fr}.masthead{font-size:clamp(39px,9vw,68px)}.lead-story h2{font-size:40px}.standfirst{font-size:18px}.colophon{align-items:start;flex-direction:column}.paper-nav{gap:0 22px}.front-page{padding-top:24px}}
</style>
