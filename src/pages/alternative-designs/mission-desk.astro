---
import Layout from '../../layouts/AlternativeLayout.astro';
import Ledger from '../../components/SnapshotLedger.astro';
import Activity from '../../components/SnapshotActivity.astro';
import { richContent, snapshotDate, stamp } from '../../lib/rich-alternatives';
import { profile } from '../../lib/data';
import { SITE } from '../../lib/site';
import '../../styles/rich-alternatives.css';
const { projects, articles } = await richContent();
---
<Layout title="Mission Desk" theme="mission-desk" description="A working desk of open-source tools, engineering notes and an honestly dated repository record.">
  <div class="rich-shell">
    <section class="desk-heading" aria-labelledby="desk-title">
      <div><p class="kicker">Shay / @{profile.login} / Open source since {new Date(profile.joinedAt).getUTCFullYear()}</p><h1 id="desk-title">Mission <strong>Desk.</strong></h1></div>
      <div class="desk-profile"><p>Small tools that fix specific annoyances. macOS menu-bar utilities, self-hosted services and research tooling. Public, deliberately small, and built because the thing didn't quite exist yet.</p><div class="rich-links"><a class="rich-link" href="/about">Meet the builder ↗</a><a class="rich-link" href={profile.url}>GitHub ↗</a><a class="rich-link" href={SITE.coffee}>Support ↗</a></div></div>
    </section>
    <nav class="desk-tabs" aria-label="Mission desk sections"><a href="#payloads">01 / Selected builds</a><a href="#record">02 / Repository record</a><a href="#notes">03 / Engineering notes</a><span>Data capture / {snapshotDate}</span></nav>
    <div class="operations-grid">
      <section class="payloads" id="payloads"><div class="section-label"><span class="kicker">01 / Payload manifest</span><span class="kicker">{projects.length} selected builds</span></div>
        {projects.map((p,i) => <article class={`payload scroll-entry payload-${i}`}>
          <div class="payload-id"><span>{String(i+1).padStart(2,'0')}</span><span class="kicker">{p.isFork ? 'Fork / maintained' : 'Original work'}</span></div>
          <div class="payload-body"><p class="stack">{p.stack.join(' / ')}</p><h2><a href={p.href}>{p.title} <span aria-hidden="true">↗</span></a></h2><p class="payload-tagline">{p.tagline}</p><p class="payload-excerpt">{p.excerpt}</p><dl class="payload-specs">{p.highlights.slice(0,2).map(h => <div><dt>{h.label}</dt><dd>{h.value}</dd></div>)}</dl><div class="rich-links"><a class="rich-link" href={p.href}>Project brief →</a><a class="rich-link" href={p.url}>Source code ↗</a></div></div>
        </article>)}
      </section>
      <aside class="desk-rail"><div class="rail-label"><span class="kicker">Operations log</span><span class="not-live">Snapshot, not live</span></div><Activity /><div class="desk-inventory"><span class="kicker">At capture</span><dl><div><dt>Tracked repositories</dt><dd>{profile.stats.trackedRepos}</dd></div><div><dt>Original repositories</dt><dd>{profile.stats.originalRepos}</dd></div><div><dt>Forked repositories</dt><dd>{profile.stats.forkedRepos}</dd></div></dl><a class="rich-link" href="/projects">Open the full inventory →</a></div></aside>
    </div>
    <section id="record" class="record-grid scroll-entry"><div><Ledger /><p class="snapshot-note archive-note">Full saved sample: {profile.stats.totalCommitsSampled} commits · {profile.stats.activeDays} active dates · {stamp(profile.stats.firstCommit!)} to {snapshotDate}. Calendar above shows only the labelled period.</p></div><Ledger section="languages" /></section>
    <section id="notes"><div class="section-rule"><h2>Engineering notes</h2><a class="rich-link" href="/writing">The complete reading file →</a></div><div class="notes-grid">{articles.map((a,i) => <article class="engineering-note scroll-entry"><p class="reading-date">Note {String(i+1).padStart(2,'0')} / {stamp(a.data.date)}</p><a class="note-title" href={`/writing/${a.id}`}>{a.data.title}</a><p class="note-excerpt">{a.excerpt}</p><a class="rich-link" href={`/writing/${a.id}`}>Read the note →</a></article>)}</div></section>
    <div class="desk-signoff"><p>Built because the thing<br/><strong>didn't quite exist yet.</strong></p><div><span class="kicker">Independent software / public source</span><a class="rich-link" href={SITE.coffee}>If a tool saved you an afternoon, buy me a coffee ↗</a></div></div>
  </div>
</Layout>
<style>
.desk-heading{display:grid;grid-template-columns:1.1fr 1fr;gap:36px;align-items:end;padding-bottom:24px}.desk-heading h1{font-size:clamp(44px,6.2vw,86px);font-weight:400;line-height:1.08;margin-top:8px;letter-spacing:-.065em}.desk-heading h1 strong{color:var(--accent);font-weight:750}.desk-profile>p{font-size:14px;max-width:52ch}.desk-tabs{display:flex;flex-wrap:wrap;align-items:center;border-block:2px solid var(--ink);gap:0 24px;margin-bottom:24px}.desk-tabs a{font:10px/1.6 'JetBrains Mono Variable',monospace;min-height:48px;display:flex;align-items:center;text-decoration:none}.desk-tabs a:hover{color:var(--accent)}.desk-tabs>span{font-size:10px;margin-left:auto}.operations-grid{display:grid;grid-template-columns:minmax(0,2.2fr) minmax(245px,1fr);gap:32px}.section-label{display:flex;justify-content:space-between;border-bottom:1px solid;padding-bottom:14px}.payload{display:grid;grid-template-columns:64px 1fr;border-bottom:1px solid #182b3b55;padding:24px 0}.payload-id>span:first-child{font-size:35px;line-height:1;letter-spacing:-.05em;font-weight:700;color:var(--accent)}.payload-id .kicker{writing-mode:vertical-rl;display:block;margin-top:20px;font-size:8px}.payload h2{font-size:clamp(29px,3vw,43px);margin:4px 0 10px;font-weight:650}.payload h2 a{display:flex;align-items:center;justify-content:space-between;min-height:44px;text-decoration:none;gap:12px}.payload h2 a:hover{color:var(--accent)}.payload h2 span{font-size:24px;color:var(--accent)}.payload-tagline{font-weight:600;font-size:15px;margin-bottom:12px}.payload-excerpt{font-size:13px;max-width:70ch;line-height:1.8}.payload-specs{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin:18px 0 4px;padding-top:12px;border-top:1px dotted #182b3b66}.payload-specs dt{font:9px 'JetBrains Mono Variable',monospace;text-transform:uppercase}.payload-specs dd{font-size:11px;margin:4px 0 0}.payload-0{background:var(--ink);color:var(--paper);padding:24px 20px;margin-top:18px;border-top:6px solid #d64a2b;--accent:#ffb293}.payload-0 .payload-specs{border-color:#f1edde66}.desk-rail{background:#e6e0cf;padding:20px;align-self:start;position:sticky;top:20px;border-top:6px solid var(--ink)}.rail-label{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px;margin-bottom:25px}.not-live{font-size:9px;padding:3px 5px;background:var(--ink);color:var(--paper)}.desk-inventory{margin-top:28px;border-top:2px solid;padding-top:20px}.desk-inventory dl>div{display:flex;justify-content:space-between;font-size:11px;gap:15px;margin:10px 0}.desk-inventory dd{margin:0;font-weight:700}.record-grid{display:grid;grid-template-columns:2fr 1fr;gap:40px;padding:32px;border:1px solid var(--ink);margin-top:40px;box-shadow:6px 6px 0 #182b3b16}.archive-note{padding:18px 0;border-top:1px solid #182b3b44;margin-top:20px}.notes-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:28px}.engineering-note{padding:20px 0;border-top:1px solid #182b3b55}.engineering-note .note-title{font-weight:650}.desk-signoff{display:flex;align-items:center;justify-content:space-between;gap:32px;border-top:6px solid var(--accent);margin-top:40px;padding-top:24px}.desk-signoff>p{font-size:25px;line-height:1.2;letter-spacing:-.04em}.desk-signoff>div{max-width:360px}.desk-signoff .rich-link{display:flex}
@media(min-width:1400px){.payload:not(.payload-0){grid-template-columns:80px 1fr}.payload-body{max-width:820px}}
@media(max-width:1000px){.operations-grid{grid-template-columns:minmax(0,1.8fr) minmax(230px,1fr);gap:20px}.desk-rail{position:static}.desk-tabs>span{margin-left:0}.notes-grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:720px){.desk-heading{grid-template-columns:1fr;gap:12px}.desk-profile>p{font-size:13px}.desk-tabs{gap:0 16px}.desk-tabs>span{width:100%;padding-bottom:10px}.operations-grid{grid-template-columns:1fr}.payload{grid-template-columns:40px 1fr}.payload-0{padding:18px 12px}.payload-id>span:first-child{font-size:27px}.payload-id .kicker{font-size:8px}.payload-specs{grid-template-columns:1fr}.record-grid{grid-template-columns:1fr;padding:20px;gap:30px}.notes-grid{grid-template-columns:1fr}.desk-signoff{align-items:start;flex-direction:column}.desk-heading h1{font-size:48px}.desk-tabs a{font-size:9px}.payload h2{font-size:30px}}
</style>
