<script>
  const channels = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-channel]'));
  const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-panel]'));
  const status = document.getElementById('tuner-status');
  const readout = document.getElementById('tuner-readout');

  function tune(index: number, moveFocus = false) {
    const active = channels[index];
    if (!active) return;

    channels.forEach((button, i) => button.setAttribute('aria-pressed', String(i === index)));
    panels.forEach((panel, i) => {
      panel.hidden = i !== index;
    });

    const label = active.dataset.label ?? '';
    if (readout) readout.textContent = label;
    if (status) status.textContent = `Now tuned to ${label} — channel ${index + 1} of ${channels.length}`;
    if (moveFocus) active.focus();
  }

  channels.forEach((button, i) => {
    button.addEventListener('click', () => tune(i));

    button.addEventListener('keydown', (event) => {
      const keys = ['ArrowRight', 'ArrowDown', 'ArrowLeft', 'ArrowUp', 'Home', 'End'];
      if (!keys.includes(event.key)) return;
      event.preventDefault();

      let next = i;
      if (event.key === 'ArrowRight' || event.key === 'ArrowDown') next = (i + 1) % channels.length;
      if (event.key === 'ArrowLeft' || event.key === 'ArrowUp') {
        next = (i - 1 + channels.length) % channels.length;
      }
      if (event.key === 'Home') next = 0;
      if (event.key === 'End') next = channels.length - 1;

      tune(next, true);
    });
  });
</script>
