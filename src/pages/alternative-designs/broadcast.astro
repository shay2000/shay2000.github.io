---
import Layout from '../../layouts/AlternativeLayout.astro';
import { getAlternativeContent } from '../../lib/alternatives';
import { formatDate } from '../../lib/site';
import profileJson from '../../data/profile.json';

const profile = profileJson;
const { projects, articles } = await getAlternativeContent();

/* ------------------------------------------------------------------ *
 * Real values only. Everything below is read straight out of
 * src/data/profile.json or the content collections — nothing here is
 * generated, estimated or invented for the sake of the metaphor.
 * ------------------------------------------------------------------ */
const stats = profile.stats;
const firstCommitDate = stats.firstCommit ? new Date(stats.firstCommit) : null;
const latestPushDate = new Date(stats.latestPush);
const snapshotDate = new Date(profile.generatedAt);
const joinedDate = new Date(profile.joinedAt);
const firstCommitLabel = firstCommitDate ? formatDate(firstCommitDate) : 'Not recorded';

const spanDays = firstCommitDate
  ? Math.max(1, Math.round((latestPushDate.getTime() - firstCommitDate.getTime()) / 86_400_000))
  : 1;
const dutyPercent = Math.round((stats.activeDays / spanDays) * 1000) / 10;
const commitsPerActiveDay = (stats.totalCommitsSampled / Math.max(1, stats.activeDays)).toFixed(1);

const readings = [
  { label: 'On air since', value: firstCommitLabel, note: 'First commit in the snapshot' },
  { label: 'Latest transmission', value: formatDate(latestPushDate), note: 'Most recent repository push' },
  {
    label: 'Repositories tracked',
    value: String(stats.trackedRepos),
    note: `${stats.originalRepos} original · ${stats.forkedRepos} forked`,
  },
  {
    label: 'Public repositories',
    value: String(profile.publicRepos),
    note: `Account opened ${formatDate(joinedDate)}`,
  },
  {
    label: 'Commits sampled',
    value: stats.totalCommitsSampled.toLocaleString('en-GB'),
    note: 'Commits read by the site’s snapshot script',
  },
  { label: 'Active days', value: String(stats.activeDays), note: 'Days carrying at least one commit' },
  { label: 'Languages heard', value: String(stats.distinctLanguages), note: 'Distinct languages detected' },
  {
    label: 'Stars · forks',
    value: `${stats.totalStars} · ${stats.totalForks}`,
    note: 'Totals across tracked repositories',
  },
];

/* ---- Channels: one per real project, in the collection’s order ---- */
const channels = projects.map((project, index) => ({
  ...project,
  index,
  channel: String(index + 1).padStart(2, '0'),
  provenance: project.fork ? 'Fork — continuing existing work' : 'Original repository',
}));

/* ---- Programme schedule: the six most recent real articles ---- */
const schedule = articles.slice(0, 6);

/* ---- Language frequencies ---- */
const languages = profile.topLanguages.filter((lang) => lang.percent > 0);
const maxPercent = languages.length ? languages[0].percent : 1;
/** Square-root curve so the small shares stay legible on the scale. */
const tunePosition = (percent: number) => 88 + 20 * Math.sqrt(percent / maxPercent);
const dialPosition = (percent: number) => 6 + ((tunePosition(percent) - 88) / 20) * 88;
const dialLanguages = languages.slice(0, 8);

/* ---- Decorative waveform: deterministic, original, no audio ---- */
const waveBars = Array.from({ length: 60 }, (_, i) => {
  const a = Math.sin(i * 0.47) * 0.5 + 0.5;
  const b = Math.cos(i * 0.17 + 1.2) * 0.5 + 0.5;
  return Math.round(14 + (a * 0.6 + b * 0.4) * 96);
});
---

<Layout
  title="Broadcast"
  theme="broadcast"
  description="A late-night station for useful software: real projects as channels, real writing as a programme schedule, and an honest snapshot of the numbers behind them."
>
  <div class="station wrap">

    <!-- 1 · HERO ------------------------------------------------------ -->
    <header class="hero">
      <div class="hero-copy">
        <span class="eyebrow">Direction 10 / Late-night broadcast</span>
        <h1>Useful software,<br /><em>after dark.</em></h1>
        <p>
          An independent station for small tools: menu-bar utilities, self-hosted services and the
          notes that come with them. {channels.length} channels on the dial, {schedule.length}
          programmes in the schedule, and no ads to sit through.
        </p>
        <div class="hero-actions">
          <a class="hero-cta" href="#channels">Tune to a channel <span aria-hidden="true">↓</span></a>
          <a class="text-link" href="#schedule">Read the schedule <span aria-hidden="true">↓</span></a>
        </div>
        <p class="hero-disclaimer">
          <span class="dot" aria-hidden="true"></span>
          A static page. No audio, no autoplay, no tracking — the dial is artwork, the numbers are real.
        </p>
      </div>

      <figure class="hero-art">
        <svg viewBox="0 0 520 360" role="img" aria-label="Original illustration: a tuning scale, a waveform and a needle resting on a station.">
          <defs>
            <linearGradient id="wave-fade" x1="0" y1="0" x2="1" y2="0">
              <stop offset="0" stop-color="#8cf0c7" stop-opacity="0.18" />
              <stop offset="0.5" stop-color="#8cf0c7" stop-opacity="1" />
              <stop offset="1" stop-color="#8cf0c7" stop-opacity="0.18" />
            </linearGradient>
          </defs>

          <g fill="none" stroke="#f3efe4" stroke-opacity="0.2">
            <rect x="12" y="12" width="496" height="336" rx="10" />
            <path d="M12 262h496" />
            <path d="M12 60h496" stroke-opacity="0.08" stroke-dasharray="2 8" />
          </g>

          <g fill="url(#wave-fade)">
            {waveBars.map((height, i) => (
              <rect
                class="wave-bar"
                style={`--d:${(i * 0.035).toFixed(2)}`}
                x={28 + i * 8}
                y={170 - height / 2}
                width="4"
                height={height}
                rx="2"
              />
            ))}
          </g>

          <g stroke="#f3efe4" stroke-opacity="0.3">
            {Array.from({ length: 25 }, (_, i) => (
              <line
                x1={28 + i * 19.5}
                y1="262"
                x2={28 + i * 19.5}
                y2={i % 5 === 0 ? 284 : 274}
              />
            ))}
          </g>

          <g stroke="#ff6b4a">
            <line x1="228" y1="72" x2="228" y2="300" stroke-width="2" />
            <circle cx="228" cy="72" r="6" fill="#ff6b4a" stroke="none" />
          </g>

          <g fill="#f3efe4" fill-opacity="0.55" font-family="'JetBrains Mono Variable', monospace" font-size="11">
            <text x="28" y="322">TUNE</text>
            <text x="492" y="322" text-anchor="end">CH 01–{String(channels.length).padStart(2, '0')}</text>
          </g>
        </svg>
        <figcaption>
          Original CSS and SVG: a tuning scale, a waveform and a needle. Decorative artwork — nothing
          on this page plays sound.
        </figcaption>
      </figure>
    </header>

    <!-- 2 · STATION READINGS ------------------------------------------ -->
    <section class="console" aria-labelledby="console-title">
      <div class="console-head">
        <span class="eyebrow">Station readings / static snapshot</span>
        <h2 id="console-title">What the dial is actually reporting.</h2>
        <p>
          The panel is styled like a live meter, but it is an honest one: every figure is read from
          this site’s own GitHub snapshot, captured {formatDate(snapshotDate)}. Nothing here updates
          while you watch, and nothing is extrapolated from it.
        </p>
      </div>

      <dl class="readings">
        {readings.map((reading) => (
          <div class="reading">
            <dt>{reading.label}</dt>
            <dd>
              {reading.value}
              <span class="reading-note">{reading.note}</span>
            </dd>
          </div>
        ))}
      </dl>

      <div class="meter">
        <div class="meter-head">
          <span class="eyebrow">Duty cycle</span>
          <span class="eyebrow">{stats.activeDays} active days / {spanDays} days on record</span>
        </div>
        <div
          class="meter-track"
          role="img"
          aria-label={`${stats.activeDays} of ${spanDays} days since the first commit carry at least one commit — ${dutyPercent}%`}
        >
          <span style={`width:${Math.max(1.5, dutyPercent)}%`}></span>
        </div>
        <p>
          {dutyPercent}% of the days between {firstCommitLabel} and {formatDate(latestPushDate)} carry
          at least one commit — roughly {commitsPerActiveDay} commits per active day, across
          {stats.distinctLanguages} languages and {stats.trackedRepos} tracked repositories. Quiet
          weeks are part of the picture too.
        </p>
      </div>
    </section>

    <!-- 3 · CHANNELS -------------------------------------------------- -->
    <section class="channels" id="channels" aria-labelledby="channels-title">
      <div class="section-head">
        <span class="eyebrow">Channel selector / {channels.length} stations</span>
        <h2 id="channels-title">Pick a frequency. Read the liner notes.</h2>
        <p>
          Each channel is one real project. Choose with a click, or step through the strip with the
          arrow keys — the reader pane follows the tuning.
        </p>
      </div>

      <noscript>
        <p class="noscript-note">
          JavaScript is off, so the tuner is showing channel 01 only. Every station is listed below.
        </p>
        <ul class="noscript-list">
          {channels.map((project) => (
            <li>
              <a href={project.href}>
                <span>CH {project.channel}</span>
                {project.title} — {project.description}
              </a>
            </li>
          ))}
        </ul>
      </noscript>

      <div class="console-grid">
        <div class="tuner">
          <div class="tuner-head">
            <span class="eyebrow">Tuning strip</span>
            <span class="readout" id="tuner-readout" aria-hidden="true">
              CH {channels[0].channel} · {channels[0].title}
            </span>
          </div>

          <div class="channel-row" role="group" aria-label="Choose a project channel">
            {channels.map((project, i) => (
              <button
                type="button"
                class="channel"
                id={`tab-${i}`}
                data-channel={i}
                data-label={`CH ${project.channel} · ${project.title}`}
                aria-pressed={i === 0}
                aria-controls={`panel-${i}`}
              >
                <span class="ch-no">CH {project.channel}</span>
                <span class="ch-name">{project.title}</span>
                <span class="ch-band">{project.category}</span>
              </button>
            ))}
          </div>

          <p class="tuner-foot">
            Channel numbers are the order of this page’s project list, not a rating. Bands are the
            two categories already used across the site.
          </p>
        </div>

        <div class="reader">
          <div class="reader-head">
            <span class="eyebrow">Now tuned</span>
            <span class="eyebrow">{channels.length} channels · updated {formatDate(snapshotDate)}</span>
          </div>

          <p class="tuner-status" id="tuner-status" aria-live="polite">
            Now tuned to CH {channels[0].channel} · {channels[0].title} — channel 1 of {channels.length}
          </p>

          {channels.map((project, i) => (
            <article class="panel" id={`panel-${i}`} data-panel={i} hidden={i !== 0}>
              <div class="panel-meta">
                <span class="eyebrow">Channel {project.channel} / {String(channels.length).padStart(2, '0')}</span>
                <span class="eyebrow">Band · {project.category}</span>
              </div>
              <h3>{project.title}</h3>
              <p class="panel-desc">{project.description}</p>

              <dl class="panel-facts">
                <dt>Stack</dt>
                <dd>
                  <ul class="stack">
                    {project.stack.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </dd>
                <dt>Category</dt>
                <dd>{project.category}</dd>
                <dt>Provenance</dt>
                <dd>{project.provenance}</dd>
                <dt>Repository key</dt>
                <dd>
                  <code>{project.name}</code>
                </dd>
              </dl>

              <a class="tune-link" href={project.href}>
                Open the project page <span aria-hidden="true">↗</span>
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- 4 · PROGRAMME SCHEDULE ---------------------------------------- -->
    <section class="schedule" id="schedule" aria-labelledby="schedule-title">
      <div class="section-head">
        <span class="eyebrow">Programme schedule / writing</span>
        <h2 id="schedule-title">Tonight’s listings.</h2>
        <p>
          Six programmes, in the order they were filed. Slots are publication dates rather than
          airtimes — there is no transmitter behind this station, only a shelf of write-ups.
        </p>
      </div>

      <ol class="schedule-list">
        {schedule.map((article, i) => (
          <li class="slot">
            <span class="slot-no">Slot {String(i + 1).padStart(2, '0')}</span>
            <time class="slot-date" datetime={article.data.date.toISOString()}>
              {formatDate(article.data.date)}
            </time>
            <div class="slot-body">
              <h3>
                <a href={`/writing/${article.id}`}>{article.data.title}</a>
              </h3>
              <p>{article.data.description}</p>
              <ul class="slot-tags">
                {article.data.featured && <li class="tag tag-featured">Featured</li>}
                {article.data.tags.map((tag) => (
                  <li class="tag">{tag}</li>
                ))}
              </ul>
            </div>
            <span class="slot-arrow" aria-hidden="true">↗</span>
          </li>
        ))}
      </ol>

      <div class="schedule-foot">
        <a class="text-link" href="/writing">All writing in the archive <span aria-hidden="true">↗</span></a>
        <span class="eyebrow">
          {articles.length} programmes filed in total · tags shown are the real frontmatter tags
        </span>
      </div>
    </section>

    <!-- 5 · LANGUAGE FREQUENCIES -------------------------------------- -->
    <section class="frequencies" id="frequencies" aria-labelledby="frequencies-title">
      <div class="section-head">
        <span class="eyebrow">Language frequencies / {languages.length} bands in the top set</span>
        <h2 id="frequencies-title">What the station is mostly made of.</h2>
        <p>
          Byte shares from the same snapshot, mapped onto a tuning scale. The percentages and byte
          counts are exact; the tuning positions are an illustration, square-root scaled so the
          smaller shares stay readable rather than crushed against the left of the dial.
        </p>
      </div>

      <div class="dial">
        <div class="dial-scale" aria-hidden="true">
          {dialLanguages.map((lang) => (
            <span class="dial-mark" style={`--x:${dialPosition(lang.percent).toFixed(2)}%`}>
              <i></i>
              <b>{lang.name}</b>
              <em>{tunePosition(lang.percent).toFixed(1)}</em>
            </span>
          ))}
        </div>

        <div class="dial-legend">
          <span>Language</span>
          <span>Share of bytes</span>
          <span>%</span>
          <span>Bytes</span>
          <span>Tuning</span>
        </div>

        <ul class="dial-list">
          {languages.map((lang) => (
            <li>
              <span class="lang-name">{lang.name}</span>
              <span class="lang-bar" aria-hidden="true">
                <i style={`width:${((lang.percent / maxPercent) * 100).toFixed(2)}%`}></i>
              </span>
              <span class="lang-pct">{lang.percent}%</span>
              <span class="lang-bytes">{lang.bytes.toLocaleString('en-GB')} B</span>
              <span class="lang-tune">{tunePosition(lang.percent).toFixed(1)}</span>
            </li>
          ))}
        </ul>

        <p class="dial-note">
          {languages.length} languages carry a non-zero share of the {stats.distinctLanguages} detected
          across the snapshot. Fluent and C++ are large here because they belong to a plugin codebase,
          not to a change of heart about JavaScript.
        </p>
      </div>
    </section>

    <!-- 6 · OFF-AIR NOTES + DESIGN NOTE -------------------------------- -->
    <section class="signoff" aria-labelledby="signoff-title">
      <div class="signoff-copy">
        <span class="eyebrow">Design note / Direction 10</span>
        <h2 id="signoff-title">Broadcast</h2>
        <p>
          The mood here is late-night radio: a tuning scale, a channel strip, a programme listing and
          a waveform. All of it is original CSS and SVG drawn for this page — the needle, the ticks
          and the bars are generated from a fixed formula, not traced from anyone’s station identity.
        </p>
        <p>
          The metaphor is deliberately kept honest. There is no audio, no live feed and no listening
          figure anywhere on the page; the readings carry the date they were taken, and every channel
          links back to an existing project page rather than to an invented case study.
        </p>
        <p>
          Typography stays inside the three self-hosted families the other directions use. The channel
          strip is a real button group with arrow-key navigation and a visible focus ring, the reader
          pane announces its changes politely, and the waveform animation is switched off entirely
          when the reader prefers reduced motion.
        </p>

        <ul class="principles">
          <li><span class="eyebrow">01</span>Nothing plays on its own.</li>
          <li><span class="eyebrow">02</span>Numbers carry their source and their date.</li>
          <li><span class="eyebrow">03</span>Every channel leads somewhere real.</li>
        </ul>

        <a class="board-link" href="/alternative-designs">
          Back to the mood board <span aria-hidden="true">↗</span>
        </a>
      </div>

      <aside class="credits" aria-label="Direction credits">
        <div class="swatches">
          <span style="background:#0b1020" aria-hidden="true"></span>
          <span style="background:#f3efe4" aria-hidden="true"></span>
          <span style="background:#8cf0c7" aria-hidden="true"></span>
          <span style="background:#ff6b4a" aria-hidden="true"></span>
        </div>
        <dl>
          <dt>Direction</dt>
          <dd>10 / Broadcast</dd>
          <dt>Palette</dt>
          <dd>#0b1020 · #f3efe4 · #8cf0c7 · #ff6b4a</dd>
          <dt>Typography</dt>
          <dd>Inter Variable / Fraunces Variable / JetBrains Mono Variable</dd>
          <dt>Data source</dt>
          <dd>Site snapshot of {formatDate(snapshotDate)}</dd>
          <dt>Contents</dt>
          <dd>{channels.length} project channels · {schedule.length} scheduled articles · {languages.length} language bands</dd>
          <dt>Elsewhere</dt>
          <dd>
            <a href="/">Original homepage ↗</a>
            <a href="/projects">All projects ↗</a>
            <a href="/writing">All writing ↗</a>
          </dd>
        </dl>
      </aside>
    </section>
  </div>
</Layout>

<style>
  /* ---------------------------------------------------------------- *
   * Page tokens. The layout sets --paper/--ink/--accent; this theme
   * overrides them on the body class the layout applies.
   * ---------------------------------------------------------------- */
  :global(body.broadcast) {
    --navy: #0b1020;
    --warm: #f3efe4;
    --mint: #8cf0c7;
    --coral: #ff6b4a;
    --paper: #0b1020;
    --ink: #f3efe4;
    --accent: #8cf0c7;
    --line: color-mix(in srgb, #f3efe4 22%, transparent);
    --line-soft: color-mix(in srgb, #f3efe4 11%, transparent);
    --muted: color-mix(in srgb, #f3efe4 64%, transparent);
    background: var(--navy);
    color: var(--warm);
    color-scheme: dark;
  }

  .station {
    padding-block: clamp(30px, 5vw, 64px) 76px;
  }

  .station :global(a) {
    text-underline-offset: 5px;
  }

  .eyebrow {
    color: var(--muted);
  }

  h2 {
    font-weight: 450;
  }

  /* ---------------------------------------------------------------- *
   * 1 · Hero
   * ---------------------------------------------------------------- */
  .hero {
    display: grid;
    grid-template-columns: 1.02fr 0.98fr;
    gap: clamp(30px, 4vw, 66px);
    align-items: center;
    padding-bottom: clamp(38px, 5vw, 66px);
    border-bottom: 1px solid var(--line);
  }

  .hero-copy h1 {
    font-size: clamp(46px, 6.6vw, 96px);
    font-weight: 450;
    margin: 22px 0 0;
  }

  .hero-copy h1 em {
    font-family: 'Fraunces Variable', Georgia, serif;
    font-style: italic;
    font-weight: 400;
    color: var(--mint);
  }

  .hero-copy > p {
    max-width: 46ch;
    font-size: 17px;
    margin-top: 26px;
    color: var(--warm);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 26px;
    margin-top: 30px;
  }

  .hero-cta {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    min-height: 48px;
    padding: 12px 20px;
    border: 1px solid var(--mint);
    color: var(--mint);
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    transition: background 0.25s ease, color 0.25s ease;
  }

  .hero-cta:hover,
  .hero-cta:focus-visible {
    background: var(--mint);
    color: var(--navy);
  }

  /* Mint buttons fill with mint on focus, so the ring switches to coral. */
  .hero-cta:focus-visible,
  .tune-link:focus-visible {
    outline: 3px solid var(--coral);
    outline-offset: 3px;
  }

  .hero-copy p.hero-disclaimer {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    margin-top: 30px;
    font-family: 'JetBrains Mono Variable', monospace;
    font-size: 10px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
    max-width: 52ch;
  }

  .dot {
    width: 7px;
    height: 7px;
    flex: none;
    margin-top: 5px;
    border-radius: 50%;
    background: var(--coral);
  }

  .hero-art {
    margin: 0;
    min-width: 0;
  }

  .hero-art svg {
    width: 100%;
    height: auto;
    border: 1px solid var(--line-soft);
    background:
      radial-gradient(120% 90% at 30% 10%, color-mix(in srgb, var(--mint) 8%, transparent), transparent 60%),
      linear-gradient(180deg, color-mix(in srgb, var(--warm) 4%, transparent), transparent 70%);
  }

  .wave-bar {
    transform-box: fill-box;
    transform-origin: center;
    animation: wave 3.4s ease-in-out infinite alternate;
    animation-delay: calc(var(--d) * 1s);
  }

  @keyframes wave {
    from {
      transform: scaleY(0.7);
    }
    to {
      transform: scaleY(1.06);
    }
  }

  .hero-art figcaption {
    margin-top: 12px;
    font-family: 'JetBrains Mono Variable', monospace;
    font-size: 10px;
    line-height: 1.7;
    color: var(--muted);
    max-width: 46ch;
  }

  /* ---------------------------------------------------------------- *
   * 2 · Station readings
   * ---------------------------------------------------------------- */
  .console {
    padding-block: clamp(44px, 6vw, 78px);
    border-bottom: 1px solid var(--line);
  }

  .section-head {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: 16px 60px;
    align-items: end;
    margin-bottom: 34px;
  }

  .section-head > .eyebrow {
    grid-column: 1 / -1;
  }

  .section-head h2,
  .console-head h2 {
    font-size: clamp(32px, 4.2vw, 58px);
    max-width: 20ch;
  }

  .section-head p,
  .console-head p {
    font-size: 15px;
    color: var(--muted);
    max-width: 56ch;
  }

  .console-head {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: 16px 60px;
    align-items: end;
    margin-bottom: 34px;
  }

  .console-head > .eyebrow {
    grid-column: 1 / -1;
  }

  .readings {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1px;
    margin: 0;
    background: var(--line-soft);
    border: 1px solid var(--line-soft);
  }

  .reading {
    background: var(--navy);
    padding: 20px 18px 22px;
    min-width: 0;
  }

  .reading dt {
    font-family: 'JetBrains Mono Variable', monospace;
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .reading dd {
    margin: 12px 0 0;
