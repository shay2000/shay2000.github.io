---
import Layout from '../../layouts/AlternativeLayout.astro';
import Ledger from '../../components/SnapshotLedger.astro';
import Activity from '../../components/SnapshotActivity.astro';
import { richContent, snapshotDate, stamp, plain } from '../../lib/rich-alternatives';
import { profile } from '../../lib/data';
import { SITE } from '../../lib/site';
import '../../styles/rich-alternatives.css';
const { projects, articles } = await richContent();
---
<Layout title="Parts Catalogue" theme="parts-catalogue" description="A working catalogue of small software: open the drawers for specifications, source and field notes.">
  <div class="rich-shell catalogue">
    <section class="catalogue-heading"><div><p class="kicker">Shay / independent software / catalogue 11</p><h1>Parts<br/><strong>Catalogue</strong><span aria-hidden="true"> /</span></h1></div><div class="maker-label"><span class="kicker">Maker identification</span><h2>@{profile.login}</h2><p>Builder · occasional writer. Small tools that fix specific annoyances: macOS menu-bar utilities, self-hosted services, and research tooling.</p><p class="stack">Open source since {new Date(profile.joinedAt).getUTCFullYear()} · Public, deliberately small.</p><div class="rich-links"><a class="rich-link" href="/about">About →</a><a class="rich-link" href={profile.url}>GitHub ↗</a><a class="rich-link" href={SITE.coffee}>Support ↗</a></div></div></section>
    <nav class="catalogue-tabs" aria-label="Catalogue sections"><a href="#drawers">01 / Components</a><a href="#bench">02 / Bench record</a><a href="#manuals">03 / Manuals</a><span class="kicker">Snapshot · {snapshotDate}</span></nav>
    <section id="drawers" class="parts-section"><div class="parts-heading"><h2>Components in stock.</h2><p>{projects.length} selected builds. Open a drawer for the specification.<br/>Software, not physical inventory.</p></div>
      <div class="drawer-case">{projects.map((p,i) => <details class="part-drawer" open={i === 0}>
        <summary><span class="part-id">P—{String(i+1).padStart(2,'0')}</span><span class="drawer-title"><strong>{p.title}</strong><span>{p.tagline}</span></span><span class="drawer-material">{p.stack[0]}</span><span class="handle" aria-hidden="true">+</span></summary>
        <div class="drawer-content"><div class="part-description"><span class="kicker">Application / {p.isFork ? 'Fork, maintained' : 'Original work'}</span><p>{p.excerpt}</p><div class="rich-links"><a class="rich-link" href={p.href}>Open project brief →</a><a class="rich-link" href={p.url}>Source repository ↗</a></div></div><div class="specification"><h3 class="kicker">Technical specification</h3><dl>{p.highlights.map(h => <div><dt>{plain(h.label)}</dt><dd>{plain(h.value)}</dd></div>)}<div><dt>Materials</dt><dd>{p.stack.join(' / ')}</dd></div><div><dt>Repository pushed</dt><dd>{stamp(p.pushedAt)} / saved snapshot</dd></div></dl></div></div>
      </details>)}</div><div class="inventory-strip"><p>{profile.stats.trackedRepos} tracked repositories · {profile.stats.originalRepos} originals · {profile.stats.forkedRepos} forks at capture</p><a class="rich-link" href="/projects">Full inventory →</a></div>
    </section>
    <section id="bench" class="bench"><div class="bench-log"><p class="bench-label kicker">Inspection log / snapshot, not live</p><Activity /></div><div class="bench-instruments"><Ledger /><div class="materials"><Ledger section="languages" /></div></div></section>
    <section id="manuals"><div class="section-rule"><h2>Service manuals.</h2><a class="rich-link" href="/writing">All writing →</a></div><div class="manual-rack">{articles.map((a,i) => <article class="manual scroll-entry"><div class="manual-spine"><span>FIELD NOTE / {String(i+1).padStart(2,'0')}</span><span>{stamp(a.data.date)}</span></div><div class="manual-body"><a class="note-title" href={`/writing/${a.id}`}>{a.data.title}</a><p class="note-excerpt">{a.excerpt}</p><a class="rich-link" href={`/writing/${a.id}`}>Read manual →</a></div></article>)}</div></section>
    <div class="order-slip"><div><span class="kicker">No purchase required</span><h2>Take what you need.<br/>See how it works.</h2></div><div><p>Everything here links back to the real project and its public source. If a tool saved you an afternoon, you can support the next one.</p><div class="rich-links"><a class="rich-link" href={SITE.coffee}>Buy me a coffee ↗</a><a class="rich-link" href="/rss.xml">Writing RSS ↗</a></div></div></div>
  </div>
</Layout>
<style>
:global(body.parts-catalogue){--paper:#e4e1d6;--ink:#293127;--accent:#805019}.catalogue{max-width:1500px}.catalogue-heading{display:grid;grid-template-columns:1.3fr 1fr;gap:40px;align-items:center;padding-bottom:28px}h1{font-size:clamp(40px,5.6vw,80px);text-transform:uppercase;line-height:.98;font-weight:450;margin-top:12px;letter-spacing:-.065em}h1 strong{font-weight:800}h1>span{color:var(--accent)}.maker-label{background:#f6f2e6;border:1px solid #29312766;padding:20px 24px;box-shadow:3px 3px 0 #29312722;transform:rotate(-.5deg)}.maker-label h2{font-size:24px;margin:10px 0}.maker-label>p{font-size:13px;margin-bottom:10px}.catalogue-tabs{display:flex;flex-wrap:wrap;gap:0 25px;border-block:2px solid;margin-bottom:25px}.catalogue-tabs a{display:flex;align-items:center;min-height:48px;font:11px 'JetBrains Mono Variable',monospace;text-decoration:none}.catalogue-tabs>span{align-self:center;margin-left:auto}.parts-heading{display:flex;justify-content:space-between;gap:20px;align-items:end;margin-bottom:20px}.parts-heading h2{font-size:32px}.parts-heading p{font-size:12px}.drawer-case{border:1px solid #293127;border-bottom:5px solid #293127;box-shadow:6px 6px 0 #29312720;padding:7px;background:#a8aa9d}.part-drawer{background:#efede3;border:1px solid #29312780;margin:0 0 6px}.part-drawer:last-child{margin:0}.part-drawer summary{list-style:none;display:grid;grid-template-columns:76px 1fr 120px 48px;gap:20px;align-items:center;padding:20px;min-height:110px;box-shadow:inset 0 -4px 0 #29312710;transition:background .2s}.part-drawer summary::-webkit-details-marker{display:none}.part-drawer summary:hover{background:#f9f6ec}.part-id{font:12px 'JetBrains Mono Variable',monospace;border:1px solid;padding:10px 5px;text-align:center}.drawer-title strong{display:block;font-size:28px;font-weight:650;line-height:1.1;letter-spacing:-.04em}.drawer-title>span{display:block;font-size:12px;margin-top:8px;max-width:75ch}.drawer-material{font:11px 'JetBrains Mono Variable',monospace}.handle{border:2px solid;border-radius:3px;border-bottom-width:5px;display:grid;place-items:center;width:48px;height:44px;font-size:23px;box-shadow:0 3px 0 #29312722}.part-drawer[open] .handle{background:var(--ink);color:#f6f2e6}.part-drawer[open] .handle::after{content:'−'}.part-drawer[open] .handle{font-size:0}.part-drawer[open] .handle::after{font-size:23px}.drawer-content{display:grid;grid-template-columns:1.2fr 1fr;gap:40px;background:#f9f6ec;border-top:1px solid;padding:28px}.part-description>p{font-size:15px;line-height:1.8;margin:12px 0}.specification dl{margin:12px 0 0;font-size:12px}.specification dl>div{display:grid;grid-template-columns:1fr 1.5fr;gap:15px;border-top:1px solid #29312733;padding:9px 0}.specification dd{margin:0;font-weight:600}.inventory-strip{display:flex;justify-content:space-between;gap:20px;align-items:center;margin-top:14px;font-size:11px}.bench{display:grid;grid-template-columns:1fr 1.65fr;gap:35px;margin-top:40px;border-top:2px solid;padding-top:26px}.bench-log{background:#293127;color:#f6f2e6;padding:25px;--ink:#f6f2e6;--accent:#dfc999}.bench-label{display:block;border-bottom:1px solid;padding-bottom:15px;margin-bottom:20px}.bench-instruments{padding:20px;border:1px solid #29312766;background:#eeece3}.materials{margin-top:30px;padding-top:24px;border-top:1px dashed}.manual-rack{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}.manual{background:#f7f3e7;border:1px solid #29312766;box-shadow:3px 4px 0 #29312722}.manual-spine{display:flex;justify-content:space-between;flex-wrap:wrap;gap:8px;background:#cbcaba;padding:12px 16px;font:9px/1.5 'JetBrains Mono Variable',monospace;border-bottom:1px solid #29312766}.manual-body{padding:12px 22px 18px}.manual .note-title{font-weight:650;font-size:26px}.manual .note-excerpt{font-size:13px}.order-slip{display:grid;grid-template-columns:1fr 1fr;gap:40px;border-block:2px dashed;margin-top:40px;padding:30px 0}.order-slip h2{font-size:34px;margin-top:12px}.order-slip p{font-size:14px}.rich-link:hover{color:var(--accent)}
@media(max-width:900px){.manual-rack{grid-template-columns:1fr 1fr}.part-drawer summary{grid-template-columns:60px 1fr 44px;gap:16px}.drawer-material{display:none}.bench{grid-template-columns:1fr 1.2fr;gap:20px}}
@media(max-width:650px){.catalogue-heading,.bench,.order-slip,.drawer-content{grid-template-columns:1fr;gap:22px}.catalogue-heading h1{font-size:48px}.maker-label{transform:none;padding:18px}.catalogue-tabs{gap:0 15px}.catalogue-tabs a{font-size:10px}.catalogue-tabs>span{margin:0;padding-bottom:12px;width:100%}.parts-heading{align-items:start;flex-direction:column;gap:10px}.part-drawer summary{grid-template-columns:1fr 44px;padding:16px 12px;gap:12px}.part-id{grid-column:1;font-size:10px;justify-self:start;padding:5px 8px}.drawer-title{grid-column:1;grid-row:2}.handle{grid-column:2;grid-row:1/3;width:44px}.drawer-title strong{font-size:25px}.drawer-content{padding:18px 14px}.specification dl>div{grid-template-columns:1fr;gap:4px}.inventory-strip{align-items:start;flex-direction:column;gap:0}.manual-rack{grid-template-columns:1fr}.bench-log,.bench-instruments{padding:20px}.part-description>p{font-size:14px}}
</style>
