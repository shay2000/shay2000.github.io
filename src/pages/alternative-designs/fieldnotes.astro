---
import Layout from '../../layouts/AlternativeLayout.astro';
import Art from '../../components/AlternativeArtwork.astro';
import { getAlternativeContent } from '../../lib/alternatives';
import { formatDate } from '../../lib/site';
const { projects, articles } = await getAlternativeContent();
---
<Layout title="Fieldnotes" theme="fieldnotes">
  <div class="notebook wrap"><section class="cover"><div class="cover-copy"><span class="eyebrow">Notebook 04 / Work in the open</span><h1>Made, noticed,<br/><em>written down.</em></h1><p>Notes from the space between a small annoyance and a working piece of software.</p><a href="#notebook" class="text-link">Turn to the notes ↓</a><div class="handnote">Less ceremony.<br/>More useful things.</div></div><figure class="drawing"><span class="eyebrow">A study of things beneath things</span><Art kind="fieldnotes" /><figcaption>Layers, interfaces, and the details that make a tool feel right. An original schematic.</figcaption></figure></section>
  <section id="notebook" class="pages" aria-labelledby="notes-title"><aside><span class="eyebrow">Contents</span><h2 id="notes-title">Follow<br/> a thread.</h2><div class="topic-tabs" role="group" aria-label="Filter notebook">{['Everything','macOS','JavaScript','Privacy'].map((topic,i) => <button type="button" data-topic={topic} aria-pressed={i===0}>{topic}<span aria-hidden="true">↗</span></button>)}</div><p id="notes-status" aria-live="polite">{articles.length} notes on the desk</p><a class="text-link" href="/writing">Writing archive ↗</a></aside><div class="note-stack">{articles.map((a,i) => <article class="note" data-tags={JSON.stringify(a.data.tags)}><div class="note-meta"><span class="eyebrow">Note / 0{i+1}</span><time datetime={a.data.date.toISOString()}>{formatDate(a.data.date)}</time></div><h3><a href={`/writing/${a.id}`}>{a.data.title}</a></h3><div class="note-tags">{a.data.tags.join(' · ')}</div><details><summary>Open reading note <span aria-hidden="true">+</span></summary><p>{a.data.description}</p><a href={`/writing/${a.id}`} class="text-link">Read the essay ↗</a></details></article>)}</div></section>
  <section class="shelf"><span class="eyebrow">On the workbench</span><h2>Tools behind the notes.</h2><div>{projects.map((p,i) => <a href={p.href}><span class="eyebrow">0{i+1}</span><strong>{p.title}</strong><span>{p.description}</span><b aria-hidden="true">↗</b></a>)}</div></section></div>
</Layout>
<style>
  .notebook{padding-top:55px;padding-bottom:70px;}.cover{display:grid;grid-template-columns:1.1fr 1fr;gap:70px;align-items:center;padding-bottom:85px;}.cover h1{font-family:'Fraunces Variable',Georgia,serif;font-size:clamp(50px,6.5vw,91px);line-height:1.03;letter-spacing:-.055em;margin-top:35px;}.cover h1 em{font-weight:400;}.cover-copy>p{max-width:33ch;font-size:17px;margin-top:30px;}.cover-copy>a{margin-top:15px;}.handnote{font-family:'Fraunces Variable',Georgia,serif;font-style:italic;color:var(--accent);font-size:23px;transform:rotate(-5deg);margin-top:35px;margin-left:35px;line-height:1.3;}.drawing{margin:0;position:relative;background:#f8f2e6;padding:26px 22px;transform:rotate(3deg);border:1px solid #bcb69f;box-shadow:5px 8px 0 #364f3e0a;}.drawing::before{content:'';position:absolute;top:-15px;left:35%;width:100px;height:30px;background:#cfc5a999;transform:rotate(-8deg);}.drawing svg{width:100%;}.drawing figcaption{font-size:11px;font-family:'JetBrains Mono Variable',monospace;max-width:38ch;}.drawing .eyebrow{font-size:9px;}
  .pages{display:grid;grid-template-columns:240px 1fr;gap:70px;border-top:1px solid #9caa96;padding-top:55px;}aside h2{font-family:'Fraunces Variable',Georgia,serif;font-size:48px;margin:20px 0 35px;}.topic-tabs{display:flex;flex-direction:column;}.topic-tabs button{background:transparent;text-align:left;border:0;border-bottom:1px solid #b8beaa;padding:13px 8px;font-size:13px;min-height:44px;display:flex;justify-content:space-between;}.topic-tabs button[aria-pressed='true']{background:#364f3e;color:#f8f2e6;}.topic-tabs button span{opacity:0;}.topic-tabs button[aria-pressed='true'] span{opacity:1;}#notes-status{font-family:'JetBrains Mono Variable',monospace;font-size:10px;margin-top:22px;}.note-stack{border-left:1px solid #b7755b55;padding-left:38px;}.note{padding:28px 0 34px;border-bottom:1px solid #b8beaa;background:repeating-linear-gradient(transparent 0,transparent 31px,#364f3e08 31px,#364f3e08 32px);}.note:first-child{padding-top:0;}.note-meta{display:flex;justify-content:space-between;gap:20px;align-items:center;}.note-meta time{font-family:'JetBrains Mono Variable',monospace;font-size:10px;}.note h3{font-family:'Fraunces Variable',Georgia,serif;font-size:clamp(27px,3vw,43px);line-height:1.15;margin:22px 0 15px;max-width:25ch;}.note h3 a{text-decoration:none;}.note h3 a:hover{text-decoration:underline;text-decoration-thickness:1px;}.note-tags{font-size:10px;font-family:'JetBrains Mono Variable',monospace;color:#655c45;margin-bottom:15px;}summary{display:flex;justify-content:space-between;align-items:center;gap:20px;list-style:none;min-height:44px;font-size:12px;color:#a63f26;}summary::-webkit-details-marker{display:none;}summary span{font-size:24px;transition:transform .3s;}details[open] summary span{transform:rotate(45deg);}details p{font-size:14px;padding-block:15px;max-width:60ch;}
  .shelf{border-top:1px solid #9caa96;margin-top:65px;padding-top:40px;}.shelf h2{font-family:'Fraunces Variable',Georgia,serif;font-size:42px;margin:20px 0 30px;}.shelf>div{display:grid;grid-template-columns:1fr 1fr;gap:0 40px;}.shelf a{display:grid;grid-template-columns:25px 1fr 20px;gap:8px 15px;text-decoration:none;padding:20px 0;border-top:1px solid #b8beaa;}.shelf strong{font-weight:500;font-size:20px;font-family:'Fraunces Variable',Georgia,serif;}.shelf a>span:nth-child(3){grid-column:2;font-size:12px;}.shelf b{grid-column:3;grid-row:1;font-weight:400;}
  @media(max-width:850px){.cover{grid-template-columns:1fr;gap:50px;padding-bottom:50px;}.drawing{max-width:450px;justify-self:center;margin:0 8px;}.pages{grid-template-columns:1fr;gap:30px;}.topic-tabs{flex-direction:row;flex-wrap:wrap;}.topic-tabs button{flex:1;gap:15px;}.note-stack{padding-left:20px;}aside h2 br{display:none;}aside h2{margin-bottom:20px;}.shelf>div{grid-template-columns:1fr;}}@media(max-width:400px){.note-stack{padding-left:12px;}.note-meta{gap:5px;}.note-meta time{font-size:9px;}.cover h1{font-size:47px;}.notebook{padding-top:35px;}}
</style>
<script>
  const topics = document.querySelectorAll<HTMLButtonElement>('[data-topic]');
  const notes = document.querySelectorAll<HTMLElement>('.note');
  topics.forEach(button => button.addEventListener('click', () => {
    topics.forEach(b => b.setAttribute('aria-pressed', String(b === button)));
    let count = 0;
    notes.forEach(note => { const tags: string[] = JSON.parse(note.dataset.tags || '[]'); note.hidden = button.dataset.topic !== 'Everything' && !tags.includes(button.dataset.topic || ''); if(!note.hidden) count++; });
    const status = document.getElementById('notes-status'); if(status) status.textContent = `${count} ${count === 1 ? 'note' : 'notes'} on the desk`;
  }));
</script>
