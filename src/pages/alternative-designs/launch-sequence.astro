---
import Layout from '../../layouts/AlternativeLayout.astro';
import { getAlternativeContent } from '../../lib/alternatives';
const { projects } = await getAlternativeContent();
---
<Layout title="Launch Sequence" theme="launch-sequence" description="An experimental, scroll-led mission control view of real projects.">
  <div class="launch"><section class="launch-hero"><div class="hero-grid"><span class="eyebrow">06 / experimental navigation study</span><span class="counter">T− 00:00:00</span></div><h1>Make the<br/><i>small</i> spectacular.</h1><p class="dek">A staged launch sequence for independent software. Scroll to move through the payload; every destination is real.</p><a class="launch-link" href="#payload">Begin sequence ↓</a><div class="orbit" aria-hidden="true"><span></span><b></b><i></i></div></section><section id="payload" class="payload" aria-labelledby="payload-title"><div class="payload-head"><span class="eyebrow">Payload manifest / {projects.length} live entries</span><h2 id="payload-title">Systems ready.</h2></div>{projects.slice(0,5).map((p,i)=><article class="chapter"><div class="chapter-no">0{i+1}</div><div><span class="eyebrow">Stage {i+1} / {p.category}</span><h3>{p.title}</h3><p>{p.description}</p><a href={p.href}>Open project ↗</a></div><div class="status" aria-label="Payload status">CLEARED</div></article>)}</section><section class="launch-end"><span class="eyebrow">Sequence complete / exploration continues</span><h2>Take the long way<br/><i>home.</i></h2><a href="/alternative-designs">Return to the mood board ↗</a></section></div>
</Layout>
<style>
.launch{background:#101010;color:#f4f0e7}.launch-hero,.payload,.launch-end{min-height:calc(100vh - 82px);padding:clamp(28px,6vw,88px) clamp(20px,7vw,110px);position:relative;overflow:hidden}.launch-hero{background:linear-gradient(135deg,#101010 0 55%,#df4a24 55%);display:flex;flex-direction:column;justify-content:center}.hero-grid{position:absolute;top:28px;left:clamp(20px,7vw,110px);right:clamp(20px,7vw,110px);display:flex;justify-content:space-between}.counter{font:11px 'JetBrains Mono Variable',monospace}.launch h1{font-size:clamp(58px,12vw,180px);line-height:.85;max-width:8ch;z-index:1}.launch i{font-family:'Fraunces Variable',serif;font-weight:400}.dek{font-size:clamp(15px,2vw,22px);max-width:34ch;margin:38px 0 28px;z-index:1}.launch-link,.launch-end a,.chapter a{display:inline-flex;align-items:center;min-height:48px;color:inherit;text-decoration:none;border-bottom:1px solid currentColor;width:max-content;font-size:13px;font-weight:600;z-index:1}.orbit{position:absolute;width:min(70vw,800px);aspect-ratio:1;border:1px solid #f4f0e755;border-radius:50%;right:-18%;top:10%;transform:rotate(-24deg)}.orbit:before,.orbit:after{content:'';position:absolute;inset:12%;border:1px solid #f4f0e744;border-radius:50%}.orbit:after{inset:28%}.orbit span,.orbit b,.orbit i{position:absolute;border-radius:50%;background:#f4f0e7;width:14px;height:14px}.orbit span{left:17%;top:28%}.orbit b{right:8%;bottom:30%;background:#101010}.orbit i{left:50%;top:50%;background:#f4f0e7;width:30px;height:30px}.payload{background:#f4f0e7;color:#101010}.payload-head{display:flex;justify-content:space-between;align-items:end;border-bottom:2px solid; padding-bottom:24px}.payload h2{font-size:clamp(42px,8vw,110px)}.chapter{display:grid;grid-template-columns:80px 1fr 120px;gap:20px;padding:clamp(28px,5vw,65px) 0;border-bottom:1px solid #10101055;align-items:start}.chapter-no,.status{font:12px 'JetBrains Mono Variable',monospace}.chapter h3{font-size:clamp(32px,5vw,72px);margin:8px 0}.chapter p{max-width:42ch;margin-bottom:22px;color:#45443e}.status{color:#df4a24;text-align:right}.launch-end{background:#df4a24;color:#101010;display:flex;flex-direction:column;justify-content:center}.launch-end h2{font-size:clamp(55px,11vw,160px);line-height:.88;margin:30px 0 45px}@media(max-width:600px){.launch-hero{background:linear-gradient(155deg,#101010 0 64%,#df4a24 64%)}.orbit{right:-55%;top:32%}.payload-head{display:block}.payload-head h2{margin-top:20px}.chapter{grid-template-columns:42px 1fr}.status{grid-column:2;text-align:left}.launch-end{min-height:75vh}}
</style>
