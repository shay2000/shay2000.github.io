---
import Layout from '../../layouts/AlternativeLayout.astro';
import Art from '../../components/AlternativeArtwork.astro';
import { getAlternativeContent } from '../../lib/alternatives';
const { projects, articles } = await getAlternativeContent();
---
<Layout title="Atlas" theme="atlas">
  <div class="wrap">
    <section class="opening">
      <div class="masthead"><span class="eyebrow">01 / The independent tool index</span><span class="eyebrow">Code · craft · curiosity</span></div>
      <h1>Small tools.<br/><em>Lasting utility.</em></h1>
      <div class="intro"><p>An atlas of open-source builds: the things that make a Mac more useful, a workflow more honest, or an ordinary screen a little less ordinary.</p><a class="text-link" href="#index">Explore the index <span>↓</span></a></div>
      <div class="hero-art"><Art kind="atlas" /><span class="eyebrow">FIG. A / Signal, stripped back</span></div>
    </section>
    <section class="index" id="index" aria-labelledby="index-title">
      <div class="index-aside"><span class="eyebrow">Selected works / 01—06</span><h2 id="index-title">Built for<br/>a reason.</h2><p>Start with the problem.<br/>The code follows.</p><a class="text-link" href="/projects">Full project archive ↗</a></div>
      <div><div class="filters" role="group" aria-label="Filter projects">{['All','Mac utilities','Web & research'].map((label,i) => <button type="button" data-filter={label} aria-pressed={i === 0}>{label}</button>)}</div><p id="filter-status" class="eyebrow" aria-live="polite">{projects.length} projects</p>
      <div class="project-index">{projects.map((p,i) => <details class="project-row" data-category={p.category}><summary><span class="num">0{i+1}</span><span><strong>{p.title}</strong><small>{p.stack.slice(0,2).join(' / ')}</small></span><span class="plus" aria-hidden="true">+</span></summary><div class="project-detail"><p>{p.description}</p><a class="text-link" href={p.href}>Read the project ↗</a></div></details>)}</div></div>
    </section>
    <section class="reading"><div><span class="eyebrow">From the margins</span><h2>The why,<br/><em>not just the what.</em></h2><a class="text-link" href="/writing">All writing ↗</a></div><div>{articles.slice(0,3).map(a => <a class="essay" href={`/writing/${a.id}`}><span class="eyebrow">{a.data.tags.slice(0,2).join(' / ')}</span><h3>{a.data.title}</h3><span aria-hidden="true">↗</span></a>)}</div></section>
  </div>
</Layout>
<style>
  .opening { position:relative; padding-block:30px 70px; border-bottom:2px solid; }
  .masthead { display:flex; justify-content:space-between; gap:16px; margin-bottom:55px; }
  h1 { font-size:clamp(64px,8.7vw,132px); line-height:.95; max-width:850px; position:relative; z-index:1; }
  h1 em,h2 em { font-family:'Fraunces Variable',Georgia,serif; font-weight:400; }
  .intro { margin-top:42px; max-width:430px; position:relative; z-index:1; }
  .intro p { font-size:16px; } .intro a { margin-top:22px; }
  .hero-art { position:absolute; right:-10px; bottom:20px; width:46%; color:#191919; }
  .hero-art .eyebrow { display:block; text-align:center; }
  .index { display:grid; grid-template-columns:1fr 2fr; gap:70px; padding-block:80px; }
  h2 { font-size:clamp(40px,4vw,62px); margin:22px 0; } .index-aside p { color:#5a5853; }
  .filters { display:flex; flex-wrap:wrap; gap:8px; margin-bottom:16px; }
  .filters button { background:none; border:1px solid #b6b4ad; border-radius:0; padding:10px 16px; min-height:44px; font-size:12px; }
  .filters button[aria-pressed='true'] { color:var(--paper); background:var(--ink); border-color:var(--ink); }
  .project-index { margin-top:16px; border-top:1px solid; }
  .project-row { border-bottom:1px solid #b6b4ad; }
  summary { display:grid; grid-template-columns:35px 1fr 24px; gap:15px; align-items:center; padding:25px 0; list-style:none; }
  summary::-webkit-details-marker { display:none; }
  .num,small { font-family:'JetBrains Mono Variable',monospace; font-size:10px; color:#5a5853; } small { display:block; margin-top:8px; }
  strong { font-size:clamp(23px,2.5vw,38px); font-weight:500; letter-spacing:-.045em; } .plus { color:var(--accent); font-size:30px; transition:transform .3s; }
  details[open] .plus { transform:rotate(45deg); } .project-detail { margin:0 35px 22px 50px; max-width:470px; }
  .reading { display:grid; grid-template-columns:1fr 1fr; gap:70px; padding-block:60px 90px; border-top:2px solid; }
  .essay { display:block; text-decoration:none; padding:24px 0; border-bottom:1px solid #b6b4ad; } .essay h3 { font-size:26px; margin:12px 0; max-width:470px; } .essay>span:last-child { color:var(--accent); }
  @media(max-width:800px) { .masthead>span:last-child{display:none;} .hero-art{position:relative;width:75%;margin:30px auto 0;right:auto;} .opening{padding-bottom:35px;} h1{font-size:clamp(55px,11vw,90px);} .intro{max-width:100%;} .index,.reading{grid-template-columns:1fr;gap:25px;padding-block:45px;} .masthead{margin-bottom:35px;} }
</style>
<script>
  const filters = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const rows = document.querySelectorAll<HTMLDetailsElement>('.project-row');
  filters.forEach(button => button.addEventListener('click', () => {
    filters.forEach(b => b.setAttribute('aria-pressed', String(b === button)));
    let count = 0;
    rows.forEach(row => { row.hidden = button.dataset.filter !== 'All' && row.dataset.category !== button.dataset.filter; if (!row.hidden) count++; });
    const status = document.getElementById('filter-status'); if (status) status.textContent = `${count} projects`;
  }));
</script>
