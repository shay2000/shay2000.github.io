---
/**
 * Direction 09 — Workbench.
 * A maker's bench and an annotated workshop ledger: paper ground, graphite ink,
 * safety orange for the live part, technical blue for measurement. Every figure
 * on this page is read from the site's own data files; the drawing is original
 * inline SVG. No external assets.
 */
import Layout from '../../layouts/AlternativeLayout.astro';
import { getAlternativeContent } from '../../lib/alternatives';
import {
  getRepo,
  repos,
  longestStreak,
  busiestMonth,
  type Profile,
} from '../../lib/data';
import {
  formatDate,
  formatBytes,
  relativeTime,
  langColor,
  readingTime,
} from '../../lib/site';
import profileJson from '../../data/profile.json';

const profile: Profile = profileJson;
const { projects, articles } = await getAlternativeContent();

/* ---------------------------------------------------------------- *
 * Stock list — real figures only, all derived at build time.
 * ---------------------------------------------------------------- */
const streak = longestStreak(profile.dayCounts);
const busiest = busiestMonth(profile.monthCounts);
const busiestLabel = busiest.month
  ? new Date(`${busiest.month}-01`).toLocaleString('en-GB', {
      month: 'long',
      year: 'numeric',
    })
  : '—';
const joinedYear = new Date(profile.joinedAt).getFullYear();
const codeVolume = formatBytes(
  repos.reduce((total, repo) => total + repo.sizeKb, 0) * 1024
);
const languageBytes = profile.topLanguages.reduce(
  (total, lang) => total + lang.bytes,
  0
);
const topLanguages = profile.topLanguages
  .filter((lang) => lang.percent >= 0.6)
  .slice(0, 8);

const stock = [
  {
    label: 'Builds tracked',
    value: String(profile.stats.trackedRepos),
    note: 'public repositories in the dataset',
  },
  {
    label: 'Original builds',
    value: String(profile.stats.originalRepos),
    note: 'written here rather than forked',
  },
  {
    label: 'Upstream forks',
    value: String(profile.stats.forkedRepos),
    note: 'projects followed from other authors',
  },
  {
    label: 'Commits sampled',
    value: String(profile.stats.totalCommitsSampled),
    note: 'across every tracked repository',
  },
  {
    label: 'Active days',
    value: String(profile.stats.activeDays),
    note: 'days with at least one commit',
  },
  {
    label: 'Languages touched',
    value: String(profile.stats.distinctLanguages),
    note: 'detected across the repositories',
  },
  {
    label: 'Longest streak',
    value: `${streak} days`,
    note: 'consecutive days with a commit',
  },
  {
    label: 'Busiest month',
    value: busiestLabel,
    note: `${busiest.count} commits in that month`,
  },
];

/* ---------------------------------------------------------------- *
 * Monthly activity — months with sampled commits, in order.
 * ---------------------------------------------------------------- */
const monthEntries = Object.entries(profile.monthCounts).sort(([a], [b]) =>
  a.localeCompare(b)
);
const peakMonthCount = Math.max(...monthEntries.map(([, count]) => count));
const months = monthEntries.map(([key, count]) => ({
  key,
  count,
  label: new Date(`${key}-01`).toLocaleString('en-GB', {
    month: 'short',
    year: 'numeric',
  }),
  height: Math.max(4, Math.round((count / peakMonthCount) * 100)),
}));
const peak = months.reduce(
  (best, month) => (month.count > best.count ? month : best),
  months[0]
);

/* ---------------------------------------------------------------- *
 * Drawers — projects joined to their repository provenance.
 * ---------------------------------------------------------------- */
const drawers = projects.map((project, index) => {
  const repo = getRepo(project.name);
  const primary = repo?.languages[0];
  return {
    ...project,
    number: String(index + 1).padStart(2, '0'),
    repo,
    fullName: repo?.fullName ?? project.name,
    sourceUrl: repo?.url ?? profile.url,
    homepage: repo?.homepage ?? null,
    language: repo?.language ?? project.stack[0] ?? '—',
    languagePercent: primary ? `${primary.percent.toFixed(1)}%` : null,
    origin: repo?.isFork ? 'Fork — upstream tracked' : 'Original repository',
    state: repo?.isArchived ? 'Archived' : 'Active',
    pushed: repo ? relativeTime(repo.pushedAt) : '—',
    pushedOn: repo ? formatDate(repo.pushedAt) : '—',
    startedOn: repo ? formatDate(repo.createdAt) : '—',
    commits: repo?.commits.length ?? 0,
    size: repo ? formatBytes(repo.sizeKb * 1024) : '—',
    licence:
      repo?.license && repo.license !== 'NOASSERTION'
        ? repo.license
        : 'Not declared',
    stars: repo?.stars ?? 0,
    topics: repo?.topics ?? [],
    branch: repo?.defaultBranch ?? 'main',
  };
});

const categoryOrder = ['Mac utilities', 'Web & research'];
const categories = [...new Set(projects.map((project) => project.category))].sort(
  (a, b) => categoryOrder.indexOf(a) - categoryOrder.indexOf(b)
);
const filters = [
  { label: 'Everything', value: 'All', count: projects.length },
  ...categories.map((category) => ({
    label: category,
    value: category,
    count: projects.filter((project) => project.category === category).length,
  })),
];

const palette = [
  { name: 'Warm paper', hex: '#f2ead9' },
  { name: 'Graphite', hex: '#20231f' },
  { name: 'Safety orange', hex: '#e75b2a' },
  { name: 'Technical blue', hex: '#275d8c' },
];
---

<Layout
  title="Workbench"
  theme="workbench"
  description="Direction 09 — a maker's bench and annotated workshop ledger: every build with its stack and provenance, every note in the logbook, all figures read from the site's own data."
>
  <div class="wrap bench">
    {/* ============ 01 · HERO ============ */}
    <section class="hero" aria-labelledby="bench-title">
      <div class="hero-copy">
        <span class="eyebrow">Direction 09 / The maker's bench</span>
        <h1 id="bench-title">Built by hand.<br /><em>Logged in detail.</em></h1>
        <p class="lede">
          A bench, not a showroom. The curated project archive sits here with the
          stack each build is made from and the provenance it carries. Behind it,
          the site tracks {profile.stats.trackedRepos} repositories — {profile.stats.originalRepos}
          original and {profile.stats.forkedRepos} followed upstream. Every number
          on this page is read from the same repository data that powers the rest
          of the site.
        </p>
        <div class="hero-actions">
          <a class="btn" href="#stock">Read the stock list <span aria-hidden="true">↓</span></a>
          <a class="btn btn--ghost" href="#drawers">Open the drawers <span aria-hidden="true">↓</span></a>
        </div>
        <dl class="hero-facts">
          <div>
            <dt>On GitHub since</dt>
            <dd>{joinedYear}</dd>
          </div>
          <div>
            <dt>Public repositories</dt>
            <dd>{profile.publicRepos}</dd>
          </div>
          <div>
            <dt>Languages touched</dt>
            <dd>{profile.stats.distinctLanguages}</dd>
          </div>
          <div>
            <dt>Commits sampled</dt>
            <dd>{profile.stats.totalCommitsSampled}</dd>
          </div>
        </dl>
      </div>

      <figure class="bench-figure">
        <div class="figure-head">
          <span>Fig. 09 — bench elevation</span>
          <span>Sheet 1 of 1 · scale NTS</span>
        </div>
        <div class="figure-body">
          <svg
            viewBox="0 0 640 430"
            role="img"
            aria-label="An original technical drawing of a workbench: a pegboard of hanging tools, a bench top holding a vise, a stack of three drawers, and a notebook leaning against the wall."
          >
            <defs>
              <pattern id="wb-pegs" width="20" height="20" patternUnits="userSpaceOnUse">
                <circle cx="10" cy="10" r="1.7" fill="#20231f" opacity="0.3" />
              </pattern>
              <marker
                id="wb-arrow"
                markerWidth="8"
                markerHeight="8"
                refX="7"
                refY="3"
                orient="auto"
                markerUnits="userSpaceOnUse"
              >
                <path d="M0 0 L7 3 L0 6 Z" fill="#275d8c" />
              </marker>
            </defs>

            {/* pegboard */}
            <rect x="44" y="22" width="552" height="128" fill="#275d8c" opacity="0.07" />
            <rect x="44" y="22" width="552" height="128" fill="url(#wb-pegs)" />
            <rect
              x="44"
              y="22"
              width="552"
              height="128"
              fill="none"
              stroke="#20231f"
              stroke-width="2"
            />

            {/* tools on the wall */}
            <g fill="none" stroke="#20231f" stroke-width="2" stroke-linejoin="round">
              <line x1="150" y1="24" x2="150" y2="54" />
              <path d="M100 56 L236 50 L242 98 L100 104 Z" fill="#f8f3e6" />
              <path
                d="M100 104 l8 6 l8 -6 l8 6 l8 -6 l8 6 l8 -6 l8 6 l8 -6 l8 6 l8 -6 l8 6 l8 -6 l8 6 l8 -6 l8 6"
              />
              <path
                d="M236 50 q40 -2 46 12 q4 16 -10 26 q-8 6 -30 10 Z"
                fill="#f8f3e6"
              />
              <circle cx="268" cy="74" r="7" />
              <rect x="300" y="44" width="130" height="16" fill="#f8f3e6" />
              <path
                d="M308 44 v8 M324 44 v8 M340 44 v8 M356 44 v11 M372 44 v8 M388 44 v8 M404 44 v11 M420 44 v8"
                stroke-width="1.4"
              />
              <g transform="translate(268 112)">
                <circle cx="0" cy="0" r="16" />
                <circle cx="0" cy="0" r="10" />
                <circle cx="0" cy="0" r="4" />
                <path d="M16 0 q22 6 16 26 q-4 14 -22 16" />
                <circle cx="10" cy="42" r="3.5" fill="#e75b2a" stroke="none" />
              </g>
              <g transform="translate(520 0)">
                <line x1="0" y1="24" x2="0" y2="62" />
                <circle cx="0" cy="20" r="4" fill="#f8f3e6" />
                <path d="M-26 62 L26 62 L36 100 L-36 100 Z" fill="#f8f3e6" />
                <g stroke="#e75b2a" stroke-width="2">
                  <line x1="-22" y1="110" x2="-30" y2="120" />
                  <line x1="0" y1="112" x2="0" y2="124" />
                  <line x1="22" y1="110" x2="30" y2="120" />
                </g>
              </g>
            </g>

            {/* leaning notebook */}
            <g transform="rotate(-7 548 172)">
              <rect x="512" y="140" width="76" height="52" fill="#f2ead9" stroke="#20231f" stroke-width="2" />
              <rect x="518" y="136" width="76" height="52" fill="#f8f3e6" stroke="#20231f" stroke-width="2" />
              <rect x="524" y="132" width="76" height="52" fill="#f8f3e6" stroke="#20231f" stroke-width="2" />
              <g stroke="#275d8c" stroke-width="1.4">
                <line x1="532" y1="150" x2="584" y2="150" />
                <line x1="532" y1="160" x2="574" y2="160" />
                <line x1="532" y1="170" x2="584" y2="170" />
              </g>
            </g>

            {/* bench top */}
            <rect x="30" y="190" width="580" height="18" fill="#f8f3e6" stroke="#20231f" stroke-width="2" />
            <line x1="30" y1="199" x2="610" y2="199" stroke="#20231f" stroke-width="1" opacity="0.35" />
            <rect x="30" y="208" width="580" height="7" fill="#20231f" opacity="0.16" />

            {/* vise */}
            <g fill="#f8f3e6" stroke="#20231f" stroke-width="2">
              <rect x="56" y="178" width="96" height="12" />
              <rect x="64" y="156" width="58" height="22" />
              <rect x="126" y="156" width="20" height="22" />
            </g>
            <g fill="none" stroke="#20231f" stroke-width="2">
              <line x1="146" y1="167" x2="196" y2="167" />
              <line x1="200" y1="152" x2="200" y2="182" />
              <circle cx="200" cy="167" r="5" fill="#e75b2a" />
            </g>

            {/* legs, braces, drawer stack */}
            <rect x="40" y="215" width="18" height="161" fill="#f8f3e6" stroke="#20231f" stroke-width="2" />
            <rect x="582" y="215" width="18" height="161" fill="#f8f3e6" stroke="#20231f" stroke-width="2" />
            <g stroke="#20231f" stroke-width="1.4" opacity="0.55">
              <line x1="58" y1="228" x2="210" y2="372" />
              <line x1="58" y1="372" x2="210" y2="228" />
              <line x1="500" y1="228" x2="582" y2="372" />
              <line x1="500" y1="372" x2="582" y2="228" />
            </g>
            <rect x="210" y="215" width="290" height="161" fill="#f8f3e6" stroke="#20231f" stroke-width="2" />
            <g fill="#f2ead9" stroke="#20231f" stroke-width="1.6">
              <rect x="222" y="227" width="266" height="44" />
              <rect x="222" y="279" width="266" height="44" />
              <rect x="222" y="331" width="266" height="33" />
            </g>
            <g fill="#20231f">
              <rect x="320" y="245" width="70" height="6" rx="3" />
              <rect x="320" y="297" width="70" height="6" rx="3" />
              <rect x="320" y="343" width="70" height="6" rx="3" />
            </g>
            <g
              font-family="JetBrains Mono Variable, monospace"
              font-size="9"
              fill="#6f6a58"
            >
              <text x="232" y="255">01</text>
              <text x="232" y="307">02</text>
              <text x="232" y="353">03</text>
            </g>
            <line x1="58" y1="372" x2="582" y2="372" stroke="#20231f" stroke-width="2" />
            <line
              x1="20"
              y1="382"
              x2="620"
              y2="382"
              stroke="#20231f"
              stroke-width="1.4"
              stroke-dasharray="10 8"
              opacity="0.5"
            />

            {/* dimension line */}
            <g stroke="#275d8c" stroke-width="1.4">
              <line x1="44" y1="374" x2="44" y2="412" stroke-dasharray="4 4" opacity="0.7" />
              <line x1="596" y1="374" x2="596" y2="412" stroke-dasharray="4 4" opacity="0.7" />
              <line x1="44" y1="404" x2="214" y2="404" marker-start="url(#wb-arrow)" marker-end="url(#wb-arrow)" />
              <line x1="426" y1="404" x2="596" y2="404" marker-start="url(#wb-arrow)" marker-end="url(#wb-arrow)" />
            </g>
            <text
              x="320"
              y="408"
              text-anchor="middle"
              font-family="JetBrains Mono Variable, monospace"
              font-size="10"
              letter-spacing="1.6"
              fill="#275d8c">NOT TO SCALE</text>

            {/* callouts */}
            <g stroke="#275d8c" stroke-width="1.2">
              <line x1="39" y1="42" x2="66" y2="64" />
              <line x1="178" y1="137" x2="150" y2="168" />
              <line x1="517" y1="292" x2="504" y2="292" />
              <line x1="597" y1="170" x2="588" y2="172" />
            </g>
            <g fill="#f8f3e6" stroke="#275d8c" stroke-width="1.6">
              <circle cx="28" cy="36" r="11" />
              <circle cx="172" cy="128" r="11" />
              <circle cx="528" cy="292" r="11" />
              <circle cx="608" cy="170" r="11" />
            </g>
            <g
              font-family="JetBrains Mono Variable, monospace"
              font-size="10"
              fill="#275d8c"
              text-anchor="middle"
            >
              <text x="28" y="40">01</text>
              <text x="172" y="132">03</text>
              <text x="528" y="296">02</text>
              <text x="608" y="174">04</text>
            </g>
          </svg>
        </div>
        <figcaption class="figure-foot">
          <div class="legend-item">
            <b>01</b>
            <span>Pegboard — {profile.stats.distinctLanguages} languages detected across the tracked repositories.</span>
          </div>
          <div class="legend-item">
            <b>02</b>
            <span>Drawer stack — {projects.length} project drawers, each with its stack and provenance.</span>
          </div>
          <div class="legend-item">
            <b>03</b>
            <span>Vise — {profile.stats.originalRepos} original builds, held in place rather than forked.</span>
          </div>
          <div class="legend-item">
            <b>04</b>
            <span>Notebook — {articles.length} written notes, kept in the logbook below.</span>
          </div>
          <p class="figure-note">
            An original drawing in inline SVG. The bench is illustrative; the
            figures beside it are the real ones.
          </p>
        </figcaption>
      </figure>
    </section>

    {/* ============ 02 · STOCK LIST ============ */}
    <section id="stock" class="stock" aria-labelledby="stock-title">
      <div class="section-head">
        <div>
          <span class="eyebrow">02 / Stock list</span>
          <h2 id="stock-title">What is on the bench.</h2>
        </div>
        <div>
          <p>
            Read from <code>profile.json</code>, <code>repos.json</code> and the
            content collections at build time. Nothing here is estimated, rounded
            up, or invented for effect.
          </p>
          <p class="stamp">
            Last generated {formatDate(profile.generatedAt)} · latest push
            {relativeTime(profile.stats.latestPush)}
          </p>
        </div>
      </div>

      <dl class="stock-grid">
        {stock.map((cell) => (
          <div class="stock-cell">
            <dt class="label">{cell.label}</dt>
            <dd class="stock-value">{cell.value}</dd>
            <dd class="stock-note">{cell.note}</dd>
          </div>
        ))}
      </dl>

      <div class="stock-panels">
        <div class="panel">
          <div class="panel-head">
            <h3>Materials</h3>
            <span class="label">by detected code volume</span>
          </div>
          <ul class="materials">
            {topLanguages.map((lang) => (
              <li>
                <span class="mat-name">
                  <i style={`background:${langColor(lang.name)}`} aria-hidden="true"></i>
                  {lang.name}
                </span>
                <span class="mat-bar" aria-hidden="true">
                  <i style={`width:${Math.max(lang.percent, 1)}%`}></i>
                </span>
                <span class="mat-pct">{lang.percent.toFixed(1)}%</span>
              </li>
            ))}
          </ul>
          <p class="panel-foot">
            {formatBytes(languageBytes)} of detected code across
            {profile.topLanguages.length} languages. {codeVolume} on disk across
            {' '}{repos.length} repositories.
          </p>
        </div>

        <div class="panel">
          <div class="panel-head">
            <h3>Activity by month</h3>
            <span class="label">{months.length} months on record</span>
          </div>
          <div
            class="chart"
            role="img"
            aria-label={`Commits sampled per month, ${months[0].label} to ${months[months.length - 1].label}. Peak ${peak.label} with ${peak.count} commits.`}
          >
            {months.map((month) => (
              <span
                class={`bar${month.key === peak.key ? ' is-peak' : ''}`}
                style={`--h:${month.height}%`}
              ></span>
            ))}
          </div>
          <div class="chart-axis">
            <span>{months[0].label}</span>
            <span class="chart-peak">peak · {peak.label} · {peak.count}</span>
            <span>{months[months.length - 1].label}</span>
          </div>
          <details class="chart-table">
            <summary>Month by month <span aria-hidden="true">+</span></summary>
            <div class="chart-scroll">
              <table>
                <caption>Commits sampled per month</caption>
                <thead>
                  <tr>
                    <th scope="col">Month</th>
                    <th scope="col">Commits</th>
                  </tr>
                </thead>
                <tbody>
                  {months.map((month) => (
                    <tr>
                      <th scope="row">{month.label}</th>
                      <td>{month.count}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </details>
          <p class="panel-foot">
            Only months with sampled commits appear, plotted in order rather than
            to a calendar scale.
          </p>
        </div>
      </div>

      <p class="stock-foot">
        {projects.length} project drawers · {articles.length} written notes ·
        {' '}{profile.publicRepos} public repositories · on GitHub since {joinedYear}
      </p>
    </section>

    {/* ============ 03 · DRAWERS ============ */}
    <section id="drawers" class="drawers" aria-labelledby="drawers-title">
      <div class="section-head">
        <div>
          <span class="eyebrow">03 / Inventory</span>
          <h2 id="drawers-title">Every drawer, pulled open.</h2>
        </div>
        <div>
          <p>
            All {projects.length} tracked builds, with the stack they are made
            from, where they came from, and links that lead somewhere real.
            Filtering is a convenience, never a gate — the full list is below.
          </p>
          <div class="filters" role="group" aria-label="Filter drawers by category">
            {filters.map((filter, index) => (
              <button
                type="button"
                data-filter={filter.value}
                aria-pressed={index === 0 ? 'true' : 'false'}
              >
                {filter.label}
                <span aria-hidden="true">{filter.count}</span>
              </button>
            ))}
          </div>
          <p id="drawer-status" class="status" role="status" aria-live="polite">
            All {projects.length} drawers open
          </p>
          <noscript>
            <p class="fallback">
              Filtering needs JavaScript. Nothing is hidden without it — all
              {' '}{projects.length} drawers are listed below, and each one opens
              with the same bench notes.
            </p>
          </noscript>
          <a class="text-link" href="/projects">Full project archive ↗</a>
        </div>
      </div>

      <div class="drawer-list">
        {drawers.map((drawer) => (
          <article
            class="drawer"
            id={`drawer-${drawer.name}`}
            data-drawer
            data-category={drawer.category}
            aria-labelledby={`drawer-title-${drawer.name}`}
          >
            <div class="drawer-head">
              <span class="drawer-num" aria-hidden="true">{drawer.number}</span>
              <div>
                <h3 id={`drawer-title-${drawer.name}`}>
                  <a href={drawer.href}>{drawer.title}</a>
                </h3>
                <p class="tagline">{drawer.description}</p>
              </div>
              <span class="drawer-cat">{drawer.category}</span>
            </div>

            <div class="drawer-body">
              <div>
                <span class="label">Stack</span>
                <ul class="chips">
                  {drawer.stack.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </div>
              <div>
                <span class="label">Provenance</span>
                <dl class="prov">
                  <div>
                    <dt>Repository</dt>
                    <dd>{drawer.fullName}</dd>
                  </div>
                  <div>
                    <dt>Origin</dt>
                    <dd>{drawer.origin}</dd>
                  </div>
                  <div>
                    <dt>Primary language</dt>
                    <dd>
                      {drawer.language}
                      {drawer.languagePercent ? ` · ${drawer.languagePercent}` : ''}
                    </dd>
                  </div>
                  <div>
                    <dt>Last push</dt>
                    <dd>
                      {drawer.pushed} <span class="dim">· {drawer.pushedOn}</span>
                    </dd>
                  </div>
                </dl>
              </div>
            </div>

            <details class="notes">
              <summary>
                Bench notes <span aria-hidden="true">+</span>
              </summary>
              <div class="notes-body">
                <dl class="notes-grid">
                  <div>
                    <dt>Started</dt>
                    <dd>{drawer.startedOn}</dd>
                  </div>
                  <div>
                    <dt>Commits sampled</dt>
                    <dd>{drawer.commits}</dd>
                  </div>
                  <div>
                    <dt>Repository size</dt>
                    <dd>{drawer.size}</dd>
                  </div>
                  <div>
                    <dt>Licence</dt>
                    <dd>{drawer.licence}</dd>
                  </div>
                  <div>
                    <dt>Default branch</dt>
                    <dd>{drawer.branch}</dd>
                  </div>
                  <div>
                    <dt>State</dt>
                    <dd>
                      {drawer.state}
                      {drawer.stars > 0 ? ` · ${drawer.stars} star${drawer.stars === 1 ? '' : 's'}` : ''}
                    </dd>
                  </div>
                  {drawer.topics.length > 0 && (
                    <div class="notes-wide">
                      <dt>Topics</dt>
                      <dd>{drawer.topics.join(' · ')}</dd>
                    </div>
                  )}
                </dl>
                <div class="drawer-links">
                  <a href={drawer.href}>Project file ↗</a>
                  <a href={drawer.sourceUrl} target="_blank" rel="noopener noreferrer">
                    Source on GitHub ↗
                  </a>
                  {drawer.homepage && drawer.homepage !== drawer.sourceUrl && (
                    <a href={drawer.homepage} target="_blank" rel="noopener noreferrer">
                      Homepage ↗
                    </a>
                  )}
                </div>
              </div>
            </details>
          </article>
        ))}
      </div>
    </section>

    {/* ============ 04 · LOGBOOK ============ */}
    <section id="logbook" class="logbook" aria-labelledby="logbook-title">
      <div class="section-head">
        <div>
          <span class="eyebrow">04 / The logbook</span>
          <h2 id="logbook-title">Written down, not just shipped.</h2>
        </div>
        <div>
          <p>
            {articles.length} notes on the shelf — the decisions, the trade-offs
            and the parts that took longer than expected. Each one links to the
            essay in full.
          </p>
          <a class="text-link" href="/writing">Writing archive ↗</a>
        </div>
      </div>

      <ol class="log">
        {articles.map((article, index) => (
          <li>
            <article class="log-item">
              <span class="log-num" aria-hidden="true">
                {String(index + 1).padStart(2, '0')}
              </span>
              <div>
                <div class="log-meta">
                  <time datetime={article.data.date.toISOString()}>
                    {formatDate(article.data.date)}
                  </time>
                  <span>{article.data.tags.join(' · ')}</span>
                  <span>{readingTime(article.body)} min read</span>
                </div>
                <h3>
                  <a href={`/writing/${article.id}`}>{article.data.title}</a>
                </h3>
                <p>{article.data.description}</p>
                <a class="log-link" href={`/writing/${article.id}`}>
                  Read the note ↗
                </a>
              </div>
            </article>
          </li>
        ))}
      </ol>
    </section>

    {/* ============ 05 · DESIGN NOTE ============ */}
    <section id="method" class="method" aria-labelledby="method-title">
      <div class="method-copy">
        <span class="eyebrow">05 / Design note</span>
        <h2 id="method-title">Why a <em>workbench</em>.</h2>
        <p>
          The other studies in this set treat the portfolio as a poster, an
          instrument, or a notebook. This one treats it as a place where things
          are actually made: a bench with tools on the wall, drawers that pull
          open, and a ledger beside it recording what was built and when.
        </p>
        <p>
          The palette comes from that workshop. Warm paper is the ground, because
          a ledger is paper before it is a screen. Graphite carries the structure.
          Safety orange is reserved for the one live thing in each view — the
          accent word, the peak month, the handle of the vise. Technical blue is
          used only for measurement: callouts, dimension lines, provenance
          labels.
        </p>
        <p>
          The bench drawing in the hero is original inline SVG, drawn for this
          page and annotated like a shop drawing. Its callouts deliberately point
          at real counts rather than decorative detail, and the caption says so.
          Filtering hides nothing that cannot be reached without it: every drawer
          is present in the markup, the controls are ordinary buttons with{' '}
          <code>aria-pressed</code>, and the bench notes use native{' '}
          <code>&lt;details&gt;</code> so they work with no JavaScript at all.
        </p>
        <p>
          Same substance as the rest of the site. Another way of handling it.
          The mood board collects the other directions, and the original homepage
          is still there if you prefer it straight.
        </p>

        <ul class="principles">
          <li>
            <strong>Grounding</strong>
            <p>Paper, hairlines and a graph grid — a surface to work on rather than a backdrop.</p>
          </li>
          <li>
            <strong>Measurement</strong>
            <p>Mono numerals for anything countable, with the source of each figure named.</p>
          </li>
          <li>
            <strong>Access</strong>
            <p>Real buttons, native disclosure, visible focus, and no reliance on hover or motion.</p>
          </li>
          <li>
            <strong>Honesty</strong>
            <p>Illustrative drawings are labelled as such. Counts come from the data files, not from copywriting.</p>
          </li>
        </ul>
      </div>

      <aside class="plate" aria-label="Materials and methods">
        <div class="plate-head">
          <span class="label">Materials &amp; methods</span>
          <span class="label">Sheet 09</span>
        </div>
        <dl class="plate-list">
          <div>
            <dt>Typography</dt>
            <dd>Inter Variable, Fraunces Variable, JetBrains Mono Variable — self-hosted</dd>
          </div>
          <div>
            <dt>Artwork</dt>
            <dd>Inline SVG and CSS only. No external assets, no photographs.</dd>
          </div>
          <div>
            <dt>Motion</dt>
            <dd>None required. Transitions are switched off under reduced-motion.</dd>
          </div>
          <div>
            <dt>Data</dt>
            <dd>profile.json, repos.json and the project &amp; article collections</dd>
          </div>
        </dl>

        <div class="swatches">
          {palette.map((swatch) => (
            <div class="swatch">
              <span style={`background:${swatch.hex}`} aria-hidden="true"></span>
              <code>{swatch.hex}</code>
              <small>{swatch.name}</small>
            </div>
          ))}
        </div>

        <nav class="plate-links" aria-label="Keep exploring">
          <a href="/alternative-designs">
            Back to the mood board <span aria-hidden="true">↗</span>
          </a>
          <a href="/">
            The original homepage <span aria-hidden="true">↗</span>
          </a>
          <a href="/projects">
            Project archive <span aria-hidden="true">↗</span>
          </a>
          <a href={profile.url} target="_blank" rel="noopener noreferrer">
            Source &amp; experiments <span aria-hidden="true">↗</span>
          </a>
        </nav>
      </aside>
    </section>
  </div>
</Layout>

