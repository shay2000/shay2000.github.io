---
import Layout from '../../layouts/AlternativeLayout.astro';
import { getAlternativeContent } from '../../lib/alternatives';
const { projects, articles } = await getAlternativeContent();
---
<Layout title="Signal / Noise" theme="signal-noise" description="An experimental interactive signal field for real projects and writing.">
<div class="field"><section class="signal-hero"><span class="eyebrow">07 / field test</span><h1>Find the<br/><em>signal.</em></h1><p>Move through the field. Or use the numbered beacons. Nothing is hidden behind hover.</p><div class="beacons" role="group" aria-label="Choose a signal">{projects.map((p,i)=><button class="beacon" data-i={i} aria-label={`Reveal ${p.title}`}><span>{String(i+1).padStart(2,'0')}</span></button>)}</div><div class="noise-lines" aria-hidden="true"></div></section><section class="reveal" aria-live="polite"><span class="eyebrow">Decoded signal</span>{projects.map((p,i)=><article class="reading" hidden={i!==0}><span class="big-no">{String(i+1).padStart(2,'0')}</span><h2>{p.title}</h2><p>{p.description}</p><a href={p.href}>Open the project ↗</a></article>)}</section><section class="writing"><span class="eyebrow">Written signals</span><h2>Noise can<br/><em>become a note.</em></h2>{articles.slice(0,3).map(a=><a href={`/writing/${a.id}`}><span>{a.data.title}</span><b>↗</b></a>)}</section></div>
</Layout>
<style>
.field{background:#090b22;color:#f8f6ed;overflow:hidden}.signal-hero,.reveal,.writing{min-height:calc(100vh - 82px);padding:clamp(28px,7vw,100px) clamp(20px,7vw,110px);position:relative}.signal-hero{background:#090b22;display:flex;flex-direction:column;justify-content:center}.signal-hero h1{font-size:clamp(70px,14vw,210px);line-height:.82;z-index:1}.signal-hero em,.writing em{font-family:'Fraunces Variable',serif;font-weight:400}.signal-hero p{max-width:32ch;font-size:17px;margin-top:35px;z-index:1}.beacons{display:flex;gap:14px;margin-top:45px;z-index:2}.beacon{width:56px;height:56px;border:1px solid #8ff4d4;background:transparent;color:#8ff4d4;border-radius:50%;font:12px 'JetBrains Mono Variable',monospace}.beacon:hover,.beacon[aria-pressed=true]{background:#8ff4d4;color:#090b22}.noise-lines{position:absolute;inset:0;background:repeating-linear-gradient(115deg,transparent 0 26px,#8ff4d411 27px 28px);transform:skewY(-8deg);animation:drift 16s linear infinite}@keyframes drift{to{transform:skewY(-8deg) translateX(80px)}}.reveal{background:#8ff4d4;color:#090b22;display:flex;flex-direction:column;justify-content:center}.reading{max-width:800px;position:relative}.big-no{font:clamp(80px,16vw,230px) 'JetBrains Mono Variable',monospace;line-height:.8;color:#090b2222}.reading h2{font-size:clamp(48px,9vw,130px);margin:20px 0 16px}.reading p{font-size:18px;max-width:45ch;margin-bottom:30px}.reading a,.writing a{color:inherit;min-height:48px;display:flex;align-items:center;text-decoration:none;border-bottom:1px solid currentColor;width:max-content;font-weight:600}.writing{background:#f2573d;color:#090b22}.writing h2{font-size:clamp(55px,10vw,140px);line-height:.88;margin:30px 0 60px}.writing>a{width:100%;max-width:800px;justify-content:space-between;padding:18px 0}.writing b{font-size:25px}@media(max-width:500px){.beacons{flex-wrap:wrap}.beacon{width:48px;height:48px}.signal-hero,.reveal,.writing{min-height:80vh}}@media(prefers-reduced-motion:reduce){.noise-lines{animation:none}}
</style>
<script>
const bs=document.querySelectorAll<HTMLButtonElement>('.beacon'); const rs=document.querySelectorAll<HTMLElement>('.reading');
bs.forEach(b=>b.addEventListener('click',()=>{const i=Number(b.dataset.i);bs.forEach(x=>x.setAttribute('aria-pressed',String(x===b)));rs.forEach((r,j)=>r.hidden=i!==j);rs[i]?.querySelector('h2')?.focus?.()}));
</script>
