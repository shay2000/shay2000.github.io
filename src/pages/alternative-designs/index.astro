---
import Layout from '../../layouts/AlternativeLayout.astro';
import Art from '../../components/AlternativeArtwork.astro';
import FlightArtwork from '../../components/FlightArtwork.astro';
import { directions } from '../../lib/alternatives';
---
<Layout title="Alternative designs">
  <div class="wrap board-wrap"><section class="board-intro"><span class="eyebrow">Design studies / Eight ways of seeing</span><h1>Same substance.<br/><em>Different senses.</em></h1><div><p>Eight original interpretations of this portfolio. Each keeps the real projects and writing, but changes how you discover them.</p><a class="text-link" href="/">Keep the original homepage ↗</a></div></section>
  <nav class="board-index" aria-label="Jump to design study">{directions.map(d => <a href={`#${d.slug}`}><span>{d.number}</span>{d.name}<span aria-hidden="true">↓</span></a>)}</nav>
  <section aria-label="Mood board and design studies">{directions.map(d => <article class={`study study-${d.slug}`} id={d.slug}><div class="study-preview"><a href={`/alternative-designs/${d.slug}`} aria-label={`Explore ${d.name} design`} class={`poster poster-${d.slug}`}><span class="eyebrow">shay2000 / {d.number}</span><strong>{d.slug === 'flight-manual' ? 'Small tools.' : d.name === 'Atlas' ? 'Small tools.': d.name === 'Studio' ? 'Useful.': d.name === 'Observatory' ? 'Follow a signal.' : 'Made, noticed.'}</strong><span class="preview-sub">{d.slug === 'flight-manual' ? 'New horizons.' : d.name === 'Atlas' ? 'Lasting utility.' : d.name === 'Studio' ? 'Not boring.' : d.name === 'Observatory' ? 'A constellation of small tools' : 'Written down.'}</span><div class="preview-art">{d.slug === 'flight-manual' ? <FlightArtwork compact /> : d.slug === 'observatory' ? <svg viewBox="0 0 600 500" aria-hidden="true"><g fill="none" stroke="currentColor"><ellipse cx="300" cy="250" rx="220" ry="130" transform="rotate(-30 300 250)"/><circle cx="300" cy="250" r="180"/><circle cx="300" cy="250" r="90"/><path d="M300 20V480M40 250H560"/></g><g fill="currentColor"><circle cx="190" cy="110" r="8"/><circle cx="390" cy="250" r="8"/><circle cx="300" cy="430" r="8"/><circle cx="300" cy="250" r="15"/></g></svg> : <Art kind={d.slug}/>}</div><span class="preview-cta">Enter {d.name} <span aria-hidden="true">↗</span></span></a><span class="preview-caption">Original composition preview — open to explore</span></div><div class="study-notes"><span class="eyebrow">Direction {d.number} / {d.mood}</span><h2>{d.name}</h2><p class="study-line">{d.line}</p><p>{d.rationale}</p><div class="swatches">{d.colours.map(c => <div><span style={`background:${c}`} aria-hidden="true"></span><code>{c}</code></div>)}</div><dl><dt>Typography</dt><dd>{d.type}</dd><dt>Interaction</dt><dd>{d.interaction}</dd><dt>Reference & principle</dt><dd><a href={d.url}>{d.reference} ↗</a><p>{d.slug==='flight-manual'?'Warm red, precise typographic hierarchy and systematic publication layouts; transformed into an original software flight manual.':d.slug==='atlas'?'Editorial hierarchy and a broad, uncluttered canvas.':d.slug==='studio'?'Tactile state changes and graphic confidence, without scroll hijacking.':d.slug==='observatory'?'Exploration through a spatial map and a focussed information panel.':'Collecting ideas through connections, with quiet navigation and room to read.'}</p></dd></dl><a class="open-design" href={`/alternative-designs/${d.slug}`}>Explore {d.name}<span aria-hidden="true">↗</span></a></div></article>)}</section>
  <section class="reference-desk"><span class="eyebrow">Additional reference desk</span><h2>Borrow the principle.<br/>Not the personality.</h2><div><p><a href="https://linear.app/">Linear ↗</a> informs Observatory’s near-black palette, fine borders and precise information hierarchy. This is a project map, not a replica of a product dashboard.</p><p><a href="https://stripe.com/">Stripe ↗</a> informs Studio’s balance of spacious typography and large colour forms. The geometric sculptures here are original CSS, not borrowed brand assets.</p><p>All five studies use self-hosted type, keyboard-operable controls and reduced-motion support. No fabricated numbers, external trackers or copied artwork. Project links lead back to the existing site.</p></div></section>
  </div>
</Layout>
<style>
  .board-wrap{padding-block:55px 70px;}.board-intro{display:grid;grid-template-columns:1.6fr 1fr;gap:30px 70px;align-items:end;}.board-intro>.eyebrow{grid-column:1/-1;}h1{font-size:clamp(47px,6vw,86px);line-height:1.03;}h1 em{font-family:'Fraunces Variable',Georgia,serif;font-weight:400;}.board-intro p{font-size:16px;max-width:38ch;}.board-intro .text-link{margin-top:15px;}.board-index{display:flex;flex-wrap:wrap;margin-top:45px;border-block:1px solid #a9aaa0;}.board-index a{display:flex;align-items:center;justify-content:space-between;gap:15px;flex:1;min-height:64px;padding:15px;text-decoration:none;font-size:14px;}.board-index a:hover{background:#e6e5dc;}.board-index a span:first-child{font-family:'JetBrains Mono Variable',monospace;font-size:10px;}.study{display:grid;grid-template-columns:1.15fr 1fr;gap:60px;padding-block:65px;border-bottom:1px solid #a9aaa0;scroll-margin-top:25px;}.study:nth-child(even) .study-preview{order:2;}.study h2{font-size:55px;margin:18px 0 12px;}.study-line{font-family:'Fraunces Variable',Georgia,serif;font-size:24px;margin-bottom:20px;}.study-notes>p:not(.study-line){font-size:14px;color:#53564e;}.study-notes>.eyebrow{font-size:10px;}.swatches{display:flex;gap:15px;margin:28px 0;}.swatches>div{flex:1;}.swatches span{display:block;height:35px;border:1px solid #0002;}.swatches code{display:block;font-size:10px;margin-top:6px;}.study dl{font-size:12px;}.study dt{font-family:'JetBrains Mono Variable',monospace;font-size:10px;text-transform:uppercase;letter-spacing:.04em;margin:18px 0 5px;}.study dd{margin:0;color:#53564e;}.study dd p{margin-top:7px;}.open-design{display:flex;justify-content:space-between;align-items:center;border:1px solid;padding:13px 16px;margin-top:25px;text-decoration:none;font-size:13px;}.open-design:hover{background:#191919;color:#f5f3ec;}.poster{position:relative;display:flex;flex-direction:column;min-height:590px;padding:30px;text-decoration:none;overflow:hidden;border:1px solid #19191922;}.poster strong{font-size:clamp(40px,4.5vw,66px);line-height:1;letter-spacing:-.065em;margin-top:40px;font-weight:600;position:relative;z-index:1;}.preview-sub{font-size:25px;line-height:1.1;position:relative;z-index:1;}.preview-art{width:100%;height:320px;margin:auto;}.preview-art svg{width:100%;height:100%;}.preview-cta{display:flex;justify-content:space-between;border-top:1px solid;padding-top:15px;font-size:12px;}.preview-caption{font-size:10px;display:block;margin-top:12px;color:#53564e;}.poster-atlas{--paper:#f5f3ec;--accent:#b83b27;background:#efeee7;}.poster-atlas .preview-sub{font-family:'Fraunces Variable',Georgia,serif;font-style:italic;}.poster-studio{--paper:#193de8;background:#193de8;color:#e0fc76;}.poster-studio strong{color:#f5f3ec;font-size:85px;font-weight:750;}.poster-studio .preview-sub{font-size:45px;font-weight:750;letter-spacing:-.06em;color:#f5f3ec;}.poster-observatory{background:#091719;color:#b7f1d4;background-image:linear-gradient(#b7f1d40a 1px,transparent 1px),linear-gradient(90deg,#b7f1d40a 1px,transparent 1px);background-size:30px 30px;}.poster-observatory strong{font-size:48px;font-weight:400;}.poster-observatory .preview-sub{font-size:11px;font-family:'JetBrains Mono Variable',monospace;margin-top:16px;}.poster-fieldnotes{--paper:#eee5d3;--accent:#a63f26;background:#eee5d3;color:#364f3e;}.poster-fieldnotes strong,.poster-fieldnotes .preview-sub{font-family:'Fraunces Variable',Georgia,serif;font-weight:400;}.poster-fieldnotes .preview-sub{font-style:italic;margin-top:8px;}.poster:hover .preview-cta span{transform:translate(3px,-3px);}.preview-cta span{transition:transform .3s;}.reference-desk{padding-top:55px;}.reference-desk h2{font-size:clamp(35px,4vw,55px);margin:20px 0 35px;}.reference-desk>div{display:grid;grid-template-columns:1fr 1fr 1fr;gap:35px;font-size:13px;color:#53564e;}.reference-desk a{font-weight:600;color:#191919;}
  .poster-flight-manual { --paper:#efeee6; --ink:#182a3c; --accent:#bb321c; color:#182a3c; background:#efeee6; border-top:8px solid #ee4b2b; }
  .poster-flight-manual .preview-sub { font-family:'Inter Variable',sans-serif; font-style:normal; }
  .poster-flight-manual .preview-art { height:260px; overflow:hidden; margin-block:22px; }
  .poster-flight-manual .preview-art :global(svg) { height:100%; width:100%; }
  .study-flight-manual .swatches { gap:6px; } .study-flight-manual .swatches code { font-size:9px; }
  .study > * { min-width: 0; } .study h2 { overflow-wrap: anywhere; }
  @media(max-width:400px) { .poster { padding:22px; } .study h2 { font-size:43px; } }
  @media(max-width:850px){.board-intro,.study{grid-template-columns:1fr;gap:30px;}.study:nth-child(even) .study-preview{order:0;}.poster{min-height:530px;}.poster strong{font-size:55px;}.reference-desk>div{grid-template-columns:1fr;gap:20px;}.board-index a{flex-basis:50%;}.board-wrap{padding-top:35px;}.study{padding-block:40px;}.preview-art{height:300px;}}
</style>
