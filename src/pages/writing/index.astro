---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getCollection } from 'astro:content';
import { tagSlug, readingTime } from '../../lib/site';

const articles = (await getCollection('articles', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

const featured = articles.filter((a) => a.data.featured);
const rest = articles.filter((a) => !a.data.featured);

// Tag counts across the collection
const tagCounts = new Map<string, number>();
for (const a of articles) {
  for (const t of a.data.tags) tagCounts.set(t, (tagCounts.get(t) || 0) + 1);
}
const tags = [...tagCounts.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));

const totalWords = articles.reduce((a, x) => a + (x.body?.split(/\s+/).length || 0), 0);
const totalMinutes = articles.reduce((a, x) => a + readingTime(x.body), 0);
---

<BaseLayout
  title="Writing"
  description="Field notes, build logs and technical write-ups — every article rendered from Markdown."
>
  <section class="shell page-head">
    <p class="label label--accent">Field notes</p>
    <h1 class="page-head__title">Notes from<br />the workbench.</h1>
    <p class="page-head__lede">
      Build logs, decisions, and the things that turned out to be harder than
      expected. Written in Markdown, because prose belongs in plain text.
    </p>

    <div class="head-stats">
      <div class="hs">
        <span class="hs__n tnum">{articles.length}</span>
        <span class="label">Articles</span>
      </div>
      <div class="hs">
        <span class="hs__n tnum">{tags.length}</span>
        <span class="label">Tags</span>
      </div>
      <div class="hs">
        <span class="hs__n tnum">{totalMinutes}</span>
        <span class="label">Minutes of reading</span>
      </div>
      <div class="hs">
        <span class="hs__n tnum">{(totalWords / 1000).toFixed(1)}k</span>
        <span class="label">Words</span>
      </div>
    </div>
  </section>

  {tags.length > 0 && (
    <section class="shell filters" aria-label="Filter by tag">
      <span class="label">Tags</span>
      <div class="chips" id="tag-chips">
        <button class="chip is-on" data-tag="all" type="button">All</button>
        {tags.map(([t, n]) => (
          <button class="chip" data-tag={tagSlug(t)} type="button">
            {t} <span class="chip__n">{n}</span>
          </button>
        ))}
      </div>
      <p class="filters__count" id="filter-count" aria-live="polite"></p>
    </section>
  )}

  <section class="shell">
    {articles.length === 0 && (
      <p class="empty">Nothing published yet — check back soon.</p>
    )}

    {featured.length > 0 && (
      <div class="featured-list">
        {featured.map((a) => (
          <div class="grid-item" data-tags={a.data.tags.map(tagSlug).join('|')}>
            <ArticleCard
              href={`/writing/${a.id}`}
              title={a.data.title}
              description={a.data.description}
              date={a.data.date}
              tags={a.data.tags}
              body={a.body}
              glyph={a.data.glyph}
              tone={a.data.tone}
              featured
            />
          </div>
        ))}
      </div>
    )}

    {rest.length > 0 && (
      <div class="article-grid" id="article-grid" data-stagger>
        {rest.map((a, i) => (
          <div class="grid-item" data-tags={a.data.tags.map(tagSlug).join('|')}>
            <ArticleCard
              href={`/writing/${a.id}`}
              title={a.data.title}
              description={a.data.description}
              date={a.data.date}
              tags={a.data.tags}
              body={a.body}
              glyph={a.data.glyph}
              tone={a.data.tone}
              index={i + 1}
            />
          </div>
        ))}
      </div>
    )}

    <p class="no-results" id="no-results" hidden>No articles with that tag.</p>
  </section>
</BaseLayout>

<style>
  .page-head {
    padding-top: clamp(2.5rem, 6vw, 5rem);
    padding-bottom: var(--sp-6);
  }

  .page-head__title {
    font-size: var(--step-4);
    margin-top: 0.6rem;
    letter-spacing: -0.032em;
  }

  .page-head__lede {
    margin-top: 1.1rem;
    max-width: 56ch;
    color: var(--ink-soft);
    font-size: var(--step-1);
    line-height: 1.5;
  }

  .head-stats {
    display: flex;
    gap: var(--sp-6);
    flex-wrap: wrap;
    margin-top: var(--sp-6);
    padding-top: var(--sp-5);
    border-top: 1px solid var(--line);
  }

  .hs {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .hs__n {
    font-family: var(--font-serif);
    font-size: var(--step-2);
    line-height: 1;
  }

  .filters {
    display: flex;
    align-items: center;
    gap: var(--sp-4);
    flex-wrap: wrap;
    padding-block: var(--sp-4);
    margin-bottom: var(--sp-6);
    border-block: 1px solid var(--line);
    position: sticky;
    top: var(--header-h);
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    z-index: 100;
  }

  .chips {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
    flex: 1;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    padding: 0.32em 0.75em;
    border: 1px solid var(--line-mid);
    border-radius: var(--r-full);
    background: var(--bg-elev);
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    cursor: pointer;
    transition: border-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out),
      background-color var(--dur-fast) var(--ease-out),
      transform var(--dur-fast) var(--ease-out);
  }

  .chip:hover {
    border-color: var(--line-strong);
    transform: translateY(-1px);
  }

  .chip.is-on {
    border-color: var(--accent);
    background: var(--accent-soft);
    color: var(--accent);
  }

  .chip__n {
    color: var(--ink-faint);
    font-variant-numeric: tabular-nums;
  }

  .filters__count {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--ink-mute);
  }

  .featured-list,
  .article-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: var(--sp-4);
  }

  .featured-list {
    /*
     * The featured pieces render in their own grid above the main article
     * grid. Inheriting `auto-fill` gave them the same three tracks as the
     * grid below, so the pair filled two thirds of the row and left a
     * ~370px void beside them while every row underneath ran full width.
     * `auto-fit` collapses the unused track, so the pair divides the row
     * evenly and still drops to one column on narrow screens.
     */
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr));
    margin-bottom: var(--sp-4);
  }

  .grid-item {
    display: contents;
  }

  .grid-item.is-hidden {
    display: none;
  }

  .empty,
  .no-results {
    padding: var(--sp-8) 0;
    text-align: center;
    color: var(--ink-mute);
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }
</style>

<script>
  const chips = document.getElementById('tag-chips');
  const items = Array.from(document.querySelectorAll<HTMLElement>('.grid-item'));
  const countEl = document.getElementById('filter-count');
  const noResults = document.getElementById('no-results');

  function apply(slug: string) {
    let visible = 0;
    for (const item of items) {
      const tags = (item.dataset.tags || '').split('|');
      const show = slug === 'all' || tags.includes(slug);
      item.classList.toggle('is-hidden', !show);
      if (show) visible++;
    }
    if (countEl) countEl.textContent = `Showing ${visible} of ${items.length}`;
    noResults?.toggleAttribute('hidden', visible > 0);
  }

  chips?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.chip');
    if (!btn) return;
    chips.querySelectorAll('.chip').forEach((c) => c.classList.toggle('is-on', c === btn));
    apply(btn.dataset.tag || 'all');
  });

  apply('all');
</script>
