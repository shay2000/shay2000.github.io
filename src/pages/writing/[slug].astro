---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getCollection, render } from 'astro:content';
import { formatDate, readingTime, tagSlug, isoDate } from '../../lib/site';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const { data, body } = entry;

const all = (await getCollection('articles', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

const i = all.findIndex((a) => a.id === entry.id);
const prev = i < all.length - 1 ? all[i + 1] : null; // older
const next = i > 0 ? all[i - 1] : null; // newer

const related = all
  .filter((a) => a.id !== entry.id)
  .map((a) => ({
    a,
    shared: a.data.tags.filter((t) => data.tags.includes(t)).length,
  }))
  .filter((x) => x.shared > 0)
  .sort((x, y) => y.shared - x.shared)
  .slice(0, 3);

const mins = readingTime(body);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const showToc = toc.length >= 3;
---

<BaseLayout
  title={data.title}
  description={data.description}
  type="article"
  published={data.date}
  updated={data.updated}
  tags={data.tags}
>
  <article class="shell art">
    <!-- ---------- Header ---------- -->
    <header class="art__head">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/writing" class="crumbs__link">Writing</a>
        <span class="crumbs__sep" aria-hidden="true">/</span>
        <span class="crumbs__here">{data.glyph} {data.tags[0] ?? 'note'}</span>
      </nav>

      <h1 class="art__title">{data.title}</h1>
      <p class="art__lede">{data.description}</p>

      <div class="art__meta">
        <span class="art__meta-item">
          <time datetime={isoDate(data.date)}>{formatDate(data.date)}</time>
        </span>
        <span class="art__dot" aria-hidden="true">·</span>
        <span class="art__meta-item">{mins} min read</span>
        {data.updated && (
          <>
            <span class="art__dot" aria-hidden="true">·</span>
            <span class="art__meta-item">updated {formatDate(data.updated)}</span>
          </>
        )}
        <span class="art__dot" aria-hidden="true">·</span>
        <span class="art__meta-item">{body.split(/\s+/).length} words</span>
      </div>

      {data.tags.length > 0 && (
        <div class="art__tags">
          {data.tags.map((t) => (
            <a class="pill" href={`/tags/${tagSlug(t)}`}>{t}</a>
          ))}
        </div>
      )}
    </header>

    <!-- ---------- Table of contents ---------- -->
    {showToc && (
      <nav class="art__toc" aria-label="On this page">
        <p class="label">On this page</p>
        <ul role="list">
          {toc.map((h) => (
            <li class:list={['toc__item', `toc__item--h${h.depth}`]}>
              <a href={`#${h.slug}`} class="toc__link">{h.text}</a>
            </li>
          ))}
        </ul>
      </nav>
    )}

    <!-- ---------- Body ---------- -->
    <div class="art__body prose">
      <Content />
    </div>

    <!-- ---------- Footer nav ---------- -->
    <footer class="art__foot">
      <div class="pager">
        {prev ? (
          <a class="pager__card card card--spot" href={`/writing/${prev.id}`}>
            <span class="label">← Older</span>
            <span class="pager__title">{prev.data.title}</span>
          </a>
        ) : (
          <span></span>
        )}
        {next ? (
          <a class="pager__card card card--spot pager__card--next" href={`/writing/${next.id}`}>
            <span class="label">Newer →</span>
            <span class="pager__title">{next.data.title}</span>
          </a>
        ) : (
          <span></span>
        )}
      </div>
    </footer>
  </article>

  {related.length > 0 && (
    <section class="shell related">
      <div class="sec-head">
        <span class="sec-head__num">↳</span>
        <h2 class="sec-head__title">Keep reading</h2>
        <a class="sec-head__link" href="/writing">All writing <span aria-hidden="true">→</span></a>
      </div>
      <div class="related__grid">
        {related.map(({ a }, idx) => (
          <ArticleCard
            href={`/writing/${a.id}`}
            title={a.data.title}
            description={a.data.description}
            date={a.data.date}
            tags={a.data.tags}
            body={a.body}
            glyph={a.data.glyph}
            tone={a.data.tone}
            index={idx + 1}
          />
        ))}
      </div>
    </section>
  )}
</BaseLayout>

<style>
  /* ---- layout ---- */
  /*
   * Rows are pinned explicitly. Without this, auto-placement sees the TOC
   * (column 2) first in source order and pushes the body down to the next
   * row, leaving the article text starting below the sidebar.
   */
  .art {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 186px;
    gap: clamp(2rem, 4vw, 3.5rem);
    max-width: 1020px;
    margin-inline: auto;
    align-items: start;
    padding-top: clamp(2.5rem, 6vw, 5rem);
  }

  .art__head {
    grid-column: 1 / -1;
    grid-row: 1;
    padding-bottom: var(--sp-6);
    border-bottom: 1px solid var(--line);
    margin-bottom: var(--sp-6);
  }

  .art__body {
    grid-column: 1;
    grid-row: 2;
    max-width: 70ch;
  }

  .art__toc {
    grid-column: 2;
    grid-row: 2;
    position: sticky;
    top: calc(var(--header-h) + 1.5rem);
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }

  .art__foot {
    grid-column: 1;
    grid-row: 3;
    margin-top: var(--sp-8);
    padding-top: var(--sp-5);
    border-top: 1px solid var(--line);
  }

  @media (max-width: 1040px) {
    .art {
      grid-template-columns: 1fr;
    }

    .art__head {
      grid-column: 1;
      grid-row: 1;
    }

    .art__toc {
      grid-column: 1;
      grid-row: 2;
      position: static;
      padding-bottom: var(--sp-5);
      border-bottom: 1px solid var(--line);
    }

    .art__body {
      grid-column: 1;
      grid-row: 3;
    }

    .art__foot {
      grid-column: 1;
      grid-row: 4;
    }
  }

  /* ---- crumbs ---- */
  .crumbs {
    display: flex;
    align-items: center;
    gap: 0.5em;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--ink-mute);
    margin-bottom: 1.25rem;
  }

  .crumbs__link:hover {
    color: var(--accent);
  }

  .crumbs__sep {
    color: var(--ink-faint);
  }

  /* ---- head ---- */
  .art__title {
    font-size: var(--step-4);
    line-height: 1.03;
    letter-spacing: -0.03em;
    font-variation-settings: 'SOFT' 20, 'WONK' 1, 'opsz' 100;
    max-width: 24ch;
  }

  .art__lede {
    margin-top: 1.1rem;
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--ink-soft);
    max-width: 60ch;
  }

  .art__meta {
    display: flex;
    align-items: center;
    gap: 0.5em;
    flex-wrap: wrap;
    margin-top: 1.4rem;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-mute);
  }

  .art__dot {
    color: var(--ink-faint);
  }

  .art__tags {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
    margin-top: 1.25rem;
  }

  /* ---- toc ---- */
  .toc__item {
    padding: 0.18rem 0;
  }

  .toc__item--h3 {
    padding-left: 0.7rem;
  }

  .toc__link {
    font-size: var(--step--2);
    color: var(--ink-mute);
    line-height: 1.4;
    display: block;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .toc__link:hover {
    color: var(--accent);
  }

  /* ---- pager ---- */
  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sp-4);
  }

  .pager__card {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: var(--sp-4) var(--sp-5);
  }

  .pager__card--next {
    text-align: right;
    align-items: flex-end;
  }

  .pager__title {
    font-family: var(--font-serif);
    font-size: var(--step-1);
    line-height: 1.2;
    transition: color var(--dur-fast);
  }

  .pager__card:hover .pager__title {
    color: var(--accent);
  }

  @media (max-width: 620px) {
    .pager {
      grid-template-columns: 1fr;
    }

    .pager__card--next {
      text-align: left;
      align-items: flex-start;
    }
  }

  /* ---- related ---- */
  .related {
    margin-top: var(--sp-8);
    padding-top: var(--sp-6);
    border-top: 1px solid var(--line);
  }

  .related__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: var(--sp-4);
  }
</style>
