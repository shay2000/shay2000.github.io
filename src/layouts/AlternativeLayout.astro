---
import '@fontsource-variable/inter';
import '@fontsource-variable/fraunces';
import '@fontsource-variable/jetbrains-mono';
import AlternativeDesigns from '../components/AlternativeDesigns.astro';
import { SITE } from '../lib/site';
interface Props { title: string; theme?: string; description?: string; }
const { title, theme = 'board', description = 'Ten original perspectives on small tools, built carefully. Explore the work and writing of shay2000.' } = Astro.props;
---
<!doctype html>
<html lang="en-GB">
<head>
  <meta name="robots" content="noindex, follow" /><meta charset="UTF-8" /><meta name="viewport" content="width=device-width" />
  <title>{title} · shay2000</title><meta name="description" content={description} />
  <link rel="canonical" href={new URL(Astro.url.pathname, SITE.url)} /><link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta property="og:title" content={`${title} · shay2000`} /><meta property="og:description" content={description} /><meta property="og:type" content="website" /><meta property="og:image" content={new URL('/og.png', SITE.url)} />
</head>
<body class={theme}>
  <a class="skip" href="#main">Skip to content</a>
  <header class="alt-header"><a class="wordmark" href="/">shay2000<span aria-hidden="true"> ↗</span></a><span class="edition">Alternative / {title}</span><AlternativeDesigns /></header>
  <main id="main"><slot /></main>
  <footer class="alt-footer"><a href="/">Original homepage ↗</a><a href="/about">A little more about me ↗</a><a href={SITE.github}>Source & experiments ↗</a><a href="/alternative-designs">Back to the mood board ↗</a><span>Same work. Another perspective.</span></footer>
</body>
</html>
<style is:global>
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; scroll-padding-top: 24px; }
  body { --paper: #f5f3ec; --ink: #191919; --accent: #b83b27; margin: 0; background: var(--paper); color: var(--ink); font-family: 'Inter Variable', sans-serif; line-height: 1.6; -webkit-font-smoothing: antialiased; }
  body.studio { --paper: #193de8; --ink: #f5f3ec; --accent: #e0fc76; }
  body.observatory { --paper: #091719; --ink: #e2eee9; --accent: #b7f1d4; color-scheme: dark; }
  body.fieldnotes { --paper: #eee5d3; --ink: #364f3e; --accent: #a63f26; }
  a { color: inherit; text-underline-offset: 5px; }
  button, input { font: inherit; }
  button, summary { cursor: pointer; }
  button { color: inherit; }
  :focus-visible { outline: 3px solid var(--accent); outline-offset: 5px; }
  h1,h2,h3,p { margin: 0; } h1,h2,h3 { line-height: 1.05; font-weight: 500; }
  h1 { letter-spacing: -.065em; } h2 { letter-spacing: -.045em; }
  svg { display: block; max-width: 100%; }
  [hidden] { display: none !important; }
  .alt-header { position: relative; z-index: 50; display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 20px clamp(20px,4vw,64px); border-bottom: 1px solid color-mix(in srgb,var(--ink) 30%,transparent); }
  .wordmark { font-weight: 700; letter-spacing: -.05em; font-size: 22px; text-decoration: none; }
  .edition,.eyebrow { font-family: 'JetBrains Mono Variable',monospace; font-size: 11px; letter-spacing: .08em; text-transform: uppercase; }
  .wrap { width: min(1440px,100%); margin: auto; padding-inline: clamp(20px,4vw,64px); }
  .alt-footer { display:flex; flex-wrap:wrap; gap: 20px 32px; justify-content: space-between; border-top: 1px solid color-mix(in srgb,var(--ink) 30%,transparent); padding: 32px clamp(20px,4vw,64px); font-size: 12px; }
  .alt-footer a { display: inline-flex; align-items: center; min-height: 44px; }
  .alt-footer span { align-self: center; }
  .skip { position:absolute; top:-100px; left:20px; padding:12px; background:var(--ink); color:var(--paper); z-index:100; }
  .skip:focus { top:10px; }
  .text-link { display: inline-flex; align-items: center; min-height: 44px; gap: 12px; font-size: 13px; font-weight: 600; }
  .alt-header .design-menu { color-scheme: light; left: auto; right: 0; }
  @media(max-width:650px) { .edition { display:none; } .alt-header { gap:12px; padding:16px 20px; } .wordmark { font-size:18px; } }
  @media(prefers-reduced-motion:reduce) { html { scroll-behavior:auto; } *,*::before,*::after { animation:none !important; transition:none !important; } }
</style>
